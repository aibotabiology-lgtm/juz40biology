{"s": [{"t": "g7s60", "g": 7, "q": ["Бактерия жасушасының тұқымқуалаушылық материалы:", ["Цитоплазмадағы ДНҚ-ның сақиналы молекуласы", "Ядродағы хромосомалар", "Хлоропластағы ДНҚ", "Рибосомадағы нәруыз"], "Бактерияда ядро жоқ, ДНҚ сақинасы цитоплазмада жүзіп жүреді.", ["Бактерияда ядро жоқ.", "Бактерияда хлоропласт жоқ.", "Рибосома нәруыз түзеді, ол тұқымқуалаушылық материал емес."]]}, {"t": "g7s60", "g": 7, "q": ["Бактерияның жалғыз қозғалу мүшесі:", ["Талшықтар", "Кірпікшелер", "Жалған аяқтар", "Қанаттар"], "Бактериялар тек талшықтар арқылы қозғалады.", ["Кірпікшелер бактерияда жоқ.", "Жалған аяқ – амебаға тән.", "Қанат бактерияда болмайды."]]}, {"t": "g7s60", "g": 7, "q": ["Бактерия жасуша қабырғасының өсімдік жасуша қабырғасынан айырмашылығы:", ["Целлюлозадан тұрмайды", "Хитиннен ғана тұрады", "Мүлде болмайды", "Крахмалдан тұрады"], "Бактерия қабырғасы целлюлозадан тұрмайды, онда басқа топтарда жоқ зат бар.", ["Оқулықта бактерия қабырғасы хитиннен тұрады делінбейді.", "Бактерияда жасуша қабырғасы бар.", "Крахмал – қор зат, қабырға түзбейді."]]}, {"t": "g7s60", "g": 7, "q": ["Көптеген бактериялардың жасуша қабырғасының сыртында болатын қабат:", ["Шырышты капсула", "Целлюлоза қабаты", "Ядро қабықшасы", "Хитин сауыт"], "Көптеген түрлерде қабырға сыртында шырышты капсула болады.", ["Бактерия қабырғасында целлюлоза жоқ.", "Бактерияда ядро қабықшасы жоқ.", "Хитин сауыт – буынаяқтыларға тән."]]}, {"t": "g7s60", "g": 7, "q": ["Бактерия споралары не үшін қажет?", ["Қолайсыз жағдайларды өткізу үшін", "Көбею үшін", "Қоректену үшін", "Қозғалу үшін"], "Спора – тыныштық күйі, қолайсыз жағдайдан аман қалуға көмектеседі.", ["Споралар көбеюге ешқашан қатыспайды.", "Спора күйінде бактерия қоректенбейді.", "Қозғалу – талшықтардың қызметі."]]}, {"t": "g7s60", "g": 7, "q": ["Колония дегеніміз:", ["Бір топқа жататын ағзалар жасушаларының бірігу формасы", "Көпжасушалы бактерия", "Бактерияның спорасы", "Бактерияның қозғалу мүшесі"], "Колонияда жасушалар бірігеді, бірақ тұтас ағза ретінде қызмет атқармайды.", ["Бактериялар ешқашан көпжасушалы болмайды.", "Спора – бір жасушаның тыныштық күйі.", "Қозғалу мүшесі – талшық."]]}, {"t": "g7s60", "g": 7, "q": ["Жасушалары тізбекке ретпен байланысқан кокктар колониясы:", ["Стрептококк", "Стафилококк", "Диплококк", "Тетракокк"], "Тізбек түзетін колония – стрептококк.", ["Стафилококк – жүзім шоғы тәрізді.", "Диплококк – екі жасушадан тұрады.", "Тетракокк – төрт жасушадан тұрады."]]}, {"t": "g7s60", "g": 7, "q": ["Жүзім шоғы сияқты қосылған кокктар:", ["Стафилококк", "Стрептококк", "Диплококк", "Вибрион"], "Стафилококк колониясы жүзім шоғына ұқсайды.", ["Стрептококк – тізбек.", "Диплококк – жұп.", "Вибрион – үтір пішінді жеке бактерия."]]}, {"t": "g7s60", "g": 7, "q": ["Бактерияның ең кең таралған пішіні:", ["Таяқшатәрізді (бацилла)", "Шартәрізді (кокк)", "Ирек (спирилла)", "Үтір пішінді (вибрион)"], "Оқулық бойынша бацилла – кең таралған пішін.", ["Кокктар жиі колония түзеді, бірақ ең кең таралған деп аталмайды.", "Ирек бактериялар сирегірек кездеседі.", "Вибриондар – аз топ."]]}, {"t": "g7s60", "g": 7, "q": ["Бациллаларға жататын паразит бактерия:", ["Кох таяқшасы", "Холера вибрионы", "Алтынтәрізді стафилококк", "Спирулина"], "Кох таяқшасы – таяқшатәрізді паразит бактерия.", ["Холера вибрионы – үтір пішінді.", "Стафилококк – шартәрізді.", "Спирулина – пайдалы фотосинтездеуші бактерия."]]}, {"t": "g7s60", "g": 7, "q": ["Пайда әкелетін фотосинтездейтін бактерия:", ["Спирулина", "Сіреспе таяқшасы", "Холера вибрионы", "Кох таяқшасы"], "Оқулық бойынша спирулина фотосинтездейді және пайда әкеледі.", ["Сіреспе таяқшасы – қауіпті паразит.", "Холера вибрионы – тырысқақ қоздырғышы.", "Кох таяқшасы – қауіпті инфекция тудырады."]]}, {"t": "g7s60", "g": 7, "q": ["Тырысқақ ауруын қоздыратын бактерияның пішіні:", ["Үтір пішінді", "Шартәрізді", "Таяқшатәрізді", "Бұрама тәрізді"], "Холера вибрионы – үтір пішінді, бір иірімі бар.", ["Шартәрізді – кокктар.", "Таяқшатәрізді – бациллалар.", "Бұрама тәрізді – спириллалар мен спирохеталар."]]}, {"t": "g7s60", "g": 7, "q": ["Вибрионның пішініне тән белгі:", ["Бір ұшы тар, екінші ұшы кең, бір иірімі бар", "Көп иірімді бұрама", "Шар тәрізді", "Тізбек түзеді"], "Вибриондардың тек бір иірімі бар, үтірге ұқсайды.", ["Көп иірімді бұрама – спириллалар.", "Шар тәрізді – кокктар.", "Тізбек түзетін – стрептококктар."]]}, {"t": "g7s60", "g": 7, "q": ["Ирек бактерияларға жататындар:", ["Спириллалар мен спирохеталар", "Бациллалар мен вибриондар", "Диплококктар мен тетракокктар", "Стафилококктар мен сарциналар"], "Спириллалар мен спирохеталардың пішіні бұрама тәрізді.", ["Бациллалар – таяқша, вибриондар – үтір пішінді.", "Диплококк, тетракокк – кокктар.", "Стафилококк, сарцина – кокктар колониясы."]]}, {"t": "g7s60", "g": 7, "q": ["Ішек таяқшасының көптеген штамдары адам үшін:", ["Ішектің қауіпсіз симбионттары", "Тырысқақ қоздырғыштары", "Сіреспе қоздырғыштары", "Фотосинтездеуші бактериялар"], "Ішек таяқшасы адам ішегінде қауіпсіз симбионт ретінде тіршілік етеді.", ["Тырысқақты холера вибрионы қоздырады.", "Сіреспені сіреспе таяқшасы қоздырады.", "Фотосинтездейтін – спирулина."]]}, {"t": "g7s61", "g": 7, "q": ["Бактерияларды Жердегі тіршіліктің «ата-бабасы» деп атайтын себеп:", ["Ғаламшардағы алғашқы тірі ағзалар болды", "Ең ірі ағзалар", "Тек паразит тіршілік етеді", "Көпжасушалы ағзалар"], "Алғашқы тірі ағзалар ретінде олар эукариотты жасушаларға бастама берді.", ["Бактериялар – ең ұсақ ағзалардың бірі.", "Бактериялардың көбі паразит емес.", "Бактериялар ешқашан көпжасушалы болмайды."]]}, {"t": "g7s61", "g": 7, "q": ["Жерде оттекті атмосфераның қалыптасуына себеп болған:", ["Алғашқы фотосинтездеуші бактериялар", "Шіріткіш бактериялар", "Сірке қышқыл бактериялары", "Сүтқышқыл бактериялар"], "Фотосинтез кезінде оттек бөлінеді; алғашқы фотосинтездеушілер – бактериялар.", ["Шіріткіштер қалдықтарды ыдыратады, оттек бөлмейді.", "Сірке қышқыл бактериялары шарапты ашытады.", "Сүтқышқыл бактериялар сүтті ашытады."]]}, {"t": "g7s61", "g": 7, "q": ["Өсімдіктер пайда болғанға дейін фотосинтезге қабілетсіз ағзаларды қорекпен қамтамасыз еткендер:", ["Фотосинтездеуші бактериялар", "Саңырауқұлақтар", "Жануарлар", "Вирустар"], "Фотосинтездеуші бактериялар бейорганикалық заттардан органикалық зат түзді.", ["Саңырауқұлақтар фотосинтездемейді.", "Жануарлар дайын органикалық затпен қоректенеді.", "Вирустар қорек түзбейді."]]}, {"t": "g7s61", "g": 7, "q": ["Бактериялар жансыз табиғаттан сіңіретін, нәруыз бен нуклеин қышқылдарына қажет элемент:", ["Азот", "Темір", "Натрий", "Хлор"], "Азотсыз нәруыздар да, нуклеин қышқылдары да түзіле алмайды.", ["Оқулықта темір туралы айтылмайды.", "Натрий бұл тақырыпта аталмайды.", "Хлор – залалсыздандырғыш ретінде белгілі, мұнда аталмайды."]]}, {"t": "g7s61", "g": 7, "q": ["Азот сіңіретін бактериялар қай өсімдіктердің тамырында селбесіп тіршілік етеді?", ["Бұршақ тұқымдастарының", "Астық тұқымдастарының", "Лалагүл тұқымдастарының", "Қылқанжапырақтылардың"], "Бұршақ тұқымдастары сондықтан нәруызға бай, топырақты азотпен байытады.", ["Астық тұқымдастарында мұндай селбесу оқулықта аталмайды.", "Лалагүл тұқымдастарына бұл тән емес.", "Қылқанжапырақтылар туралы мұндай дерек жоқ."]]}, {"t": "g7s61", "g": 7, "q": ["Бұршақ тұқымдас өсімдіктер топырақты немен байытады?", ["Азотпен", "Оттекпен", "Крахмалмен", "Тұзбен"], "Тамырындағы бактериялар азот сіңіреді – топырақ азотқа байиды.", ["Оттекті фотосинтез ауаға бөледі.", "Крахмал – өсімдік ішіндегі қор зат.", "Тұздануды бактериялар тудырмайды."]]}, {"t": "g7s61", "g": 7, "q": ["Ағза қалдықтарын қарашірікке айналдыратын бактериялар:", ["Шіріткіш және топырақ бактериялары", "Сүтқышқыл бактериялар", "Шарап бактериялары", "Холера вибриондары"], "Шіріткіштер қалдықтарды ыдыратып, элементтерді табиғатқа қайтарады.", ["Сүтқышқыл бактериялар сүтті ашытады.", "Шарап бактериялары шарап жасауға қатысады.", "Холера вибрионы – ауру қоздырғышы."]]}, {"t": "g7s61", "g": 7, "q": ["Шіріткіш бактериялар болмаса не болар еді?", ["Топырақ түзілмес еді", "Оттек көбейер еді", "Ауа тазарар еді", "Барлық ауру жойылар еді"], "Оқулық бойынша бактерия болмаса топырақ түзілмейтін еді, жер қалдықтарға толар еді.", ["Шіріткіштер оттек түзбейді.", "Қалдықтар жиналып, керісінше ортаны ластар еді.", "Ауруды шіріткіштер емес, патогендер тудырады."]]}, {"t": "g7s61", "g": 7, "q": ["Сүтқышқыл бактериялардың көмегімен дайындалмайтын өнім:", ["Маринад", "Айран", "Құрт", "Ашыған қырыққабат"], "Маринадтарды шарап және сірке қышқыл бактериялары арқылы жасайды.", ["Айран – сүтқышқыл бактериялармен.", "Құрт – сүтқышқыл бактериялармен.", "Ашыған қырыққабат – сүтқышқыл бактериялармен."]]}, {"t": "g7s61", "g": 7, "q": ["Шарапты сіркесуына айналдыратын бактериялар:", ["Сірке қышқыл бактериялары", "Сүтқышқыл бактериялар", "Азот сіңіретін бактериялар", "Фотосинтездеуші бактериялар"], "Сірке қышқыл бактериялары шарапты ашытып бұзады.", ["Сүтқышқыл бактериялар сүтті ашытады.", "Азот сіңіретіндер бұршақ тамырында тіршілік етеді.", "Фотосинтездеушілер органикалық зат түзеді."]]}, {"t": "g7s61", "g": 7, "q": ["«Суқоймалардың гүлденуі» неге байланысты?", ["Кейбір фотосинтездеуші бактериялар балдырлармен бірге суды ластайды", "Су гүлдері көбейеді", "Шіріткіштер жойылады", "Суға азот бактериялары түседі"], "Бұл – қазіргі фотосинтездеуші бактериялардың жағымсыз жағы.", ["«Гүлдену» – бактериялар мен балдырлардың көбеюі, гүлді өсімдіктер емес.", "Шіріткіштердің жойылуы мұнда себеп емес.", "Азот бактериялары бұршақ тамырында тіршілік етеді."]]}, {"t": "g7s61", "g": 7, "q": ["Сүрлеме мен жемшөп дайындауда қолданылатын бактериялар:", ["Сүтқышқыл бактериялар", "Сірке қышқыл бактериялары", "Шіріткіш бактериялар", "Ауру тудыратын бактериялар"], "Сүтқышқыл бактериялар жаңа тұздалған шөпті ашытып, сүрлеме дайындайды.", ["Сірке қышқыл бактериялары шарап, маринадқа қатысты.", "Шіріткіштер жемшөпті бұзады.", "Ауру тудыратындар өндірісте қолданылмайды."]]}, {"t": "g7s61", "g": 7, "q": ["Бактерияларды пайдалы және зиянды деп бөлу неге шартты?", ["Бір бактерия бір жағдайда пайдалы, басқа жағдайда зиянды", "Барлық бактерия тек пайдалы", "Барлық бактерия тек зиянды", "Пайдалы бактериялар болмайды"], "Мысалы, сүтқышқыл бактериялар айран жасайды, бірақ сүт өнімдерін ашытып жібереді.", ["Бактериялардың зиянды түрлері де бар.", "Пайдалы түрлері де көп.", "Шіріткіштер, сүтқышқыл бактериялар – пайдалы."]]}, {"t": "g7s62", "g": 7, "q": ["Жансыз нысандар бетіндегі патогендерді жоятын заттар:", ["Залалсыздандырушылар", "Антисептиктер", "Антибиотиктер", "Витаминдер"], "Залалсыздандырушылар (дезинфекциялық заттар) нысандардың бетін өңдейді.", ["Антисептиктер дене беті мен жарақатқа қолданылады.", "Антибиотиктер ағза ішінде әсер етеді.", "Витаминдер патогендерді жоймайды."]]}, {"t": "g7s62", "g": 7, "q": ["Жарақаттағы патогендерді жоятын йод, спирт, зеленка –", ["антисептиктер", "антибиотиктер", "залалсыздандырушылар", "вакциналар"], "Дене беті мен жараға қолданатын заттар – антисептиктер.", ["Антибиотиктер ағза ішінде әсер етеді.", "Залалсыздандырушылар жансыз нысандарға қолданылады.", "Вакциналар бұл тақырыпта аталмайды, олар жараны өңдемейді."]]}, {"t": "g7s62", "g": 7, "q": ["Ағза ішіндегі патогендерді жоятын заттар:", ["Антибиотиктер", "Антисептиктер", "Залалсыздандырушылар", "Жуғыш заттар"], "Антибиотиктер ағзаның ішінде патогендерді жояды.", ["Антисептиктер дене бетінде қолданылады.", "Залалсыздандырушылар – жансыз нысандар үшін.", "Жуғыш заттар – залалсыздандырушыларға жатады."]]}, {"t": "g7s62", "g": 7, "q": ["Залалсыздандырушыларға жатпайтын зат:", ["Зеленка", "Хлор", "Жуғыш зат", "Қышқыл ерітіндісі"], "Зеленка – антисептик, жараны өңдейді.", ["Хлор – залалсыздандырушы.", "Жуғыш заттар – залалсыздандырушы.", "Қышқылдар ерітіндісі – залалсыздандырушы."]]}, {"t": "g7s62", "g": 7, "q": ["Микробиологияның негізін қалаушы француз ғалымы:", ["Л. Пастер", "И. Земмельвейс", "Н.И. Пирогов", "Дж. Листер"], "Оқулықта Л. Пастер – микробиологияның негізін қалаушы деп аталады.", ["Земмельвейс – венгр акушері.", "Пирогов – орыс хирургі.", "Листер – хирург, антисептиканы енгізуге үлес қосқан."]]}, {"t": "g7s62", "g": 7, "q": ["Венгр акушері, антисептиканың дамуына үлес қосқан:", ["И. Земмельвейс", "Л. Пастер", "Н.И. Пирогов", "Дж. Листер"], "И. Земмельвейс – венгр акушері.", ["Пастер – француз ғалымы.", "Пирогов – орыс хирургі.", "Листер – хирург, венгр акушері емес."]]}, {"t": "g7s62", "g": 7, "q": ["Қазақстанда ерте кезден үй-жайды немен аластаған?", ["Адыраспанмен", "Хлормен", "Йодпен", "Зеленкамен"], "Адыраспан түтінінің бактерицидтік қасиеті дәлелденген.", ["Хлор – қазіргі залалсыздандырушы.", "Йод – антисептик.", "Зеленка – антисептик."]]}, {"t": "g7s62", "g": 7, "q": ["Баспа мен туберкулездің жұғу жолы:", ["Ауа-тамшылы, ыдыс және ауру адамның заты арқылы", "Ауру жануардың сүті арқылы", "Кесілген жараға топырақ тию арқылы", "Консерві арқылы"], "8-кесте бойынша олар ауа-тамшылы жолмен жұғады.", ["Сүт арқылы бруцеллез жұғады.", "Жараға топырақ тию – сіреспе.", "Консерві арқылы ботулизм жұғады."]]}, {"t": "g7s62", "g": 7, "q": ["Су, жуылмаған көкөніс және лас ыдыс-аяқ арқылы жұғатын ауру:", ["Тырысқақ", "Бруцеллез", "Сіреспе", "Конъюнктивит"], "Тырысқақ қоздырғышы су және лас тағам арқылы тарайды.", ["Бруцеллез ауру жануардан жұғады.", "Сіреспе жарадан жұғады.", "Конъюнктивит – көз ауруы, оның алдын алу көзді қорғаумен байланысты."]]}, {"t": "g7s62", "g": 7, "q": ["Бруцеллездің алдын алу шарасы:", ["Пастерленбеген не қайнатылмаған сүт өнімдерін пайдаланбау", "Дәкетаңғыш тағу", "Көзді шаңнан қорғау", "Консерві жемеу"], "Бруцеллез ауру жануардың сүті не еті арқылы жұғады.", ["Дәкетаңғыш – ауа-тамшылы ауруларға.", "Көзді қорғау – конъюнктивитке.", "Консервіден бас тарту – ботулизмге."]]}, {"t": "g7s62", "g": 7, "q": ["Ботулизмнің қоздырғышы:", ["Топырақта тіршілік ететін анаэробты бактерия", "Ауру жануардағы бактерия", "Ауа-тамшылы жолмен берілетін вирус", "Судағы қарапайымдар"], "Кесте бойынша ботулизм қоздырғышы – топырақтағы анаэробты бактерия.", ["Ауру жануардан бруцеллез, түйнеме жұғады.", "Ботулизм – бактериялық ауру, вирус емес.", "Қоздырғыш қарапайымдар емес."]]}, {"t": "g7s62", "g": 7, "q": ["Сіреспенің алдын алу шарасы:", ["Жараны антисептикпен тазалап, дәрігерге қаралу", "Сүтті қайнату", "Ауру адамды оқшаулау", "Ауру жануардың етін жемеу"], "Сіреспе топырақтан кесілген жараға түседі.", ["Сүтті қайнату – бруцеллезге қарсы.", "Оқшаулау – ауа-тамшылы ауруларға.", "Ауру жануар еті – түйнеме мен бруцеллезге қатысты."]]}, {"t": "g7s62", "g": 7, "q": ["Ауру жануарлардан жұғатын, белгілері байқалса ветеринар шақыру керек ауру:", ["Түйнеме", "Баспа", "Конъюнктивит", "Ботулизм"], "Түйнемеде ауру жануардың етін жемеу, ветеринар шақыру керек.", ["Баспа ауру адамнан ауа-тамшылы жолмен жұғады.", "Конъюнктивит – көз ауруы.", "Ботулизм – консерві арқылы."]]}, {"t": "g7s62", "g": 7, "q": ["Ауру тудыратын микроағзаларға жатпайтын топ:", ["Көпжасушалы өсімдіктер", "Қарапайымдар", "Бактериялар", "Вирустар"], "Оқулық бойынша патогендер – қарапайымдар, біржасушалы саңырауқұлақтар, бактериялар, вирустар.", ["Қарапайымдар – патоген бола алады.", "Бактериялар – патоген бола алады.", "Вирустар – патоген бола алады."]]}, {"t": "g7s63", "g": 7, "q": ["Вирус қандай екі бөліктен тұрады?", ["Нуклеин қышқылы және нәруызды қабықша", "Ядро және цитоплазма", "Жасуша қабырғасы және талшық", "Митохондрия және рибосома"], "Вирус – нуклеин қышқылы мен қабықша; жасушалық құрылысы жоқ.", ["Ядро мен цитоплазма – жасушаның бөліктері, вируста жоқ.", "Жасуша қабырғасы мен талшық – бактерияға тән.", "Вируста органоидтар жоқ."]]}, {"t": "g7s63", "g": 7, "q": ["Вирус қабықшасы неден құрылған?", ["Нәруызды бөлшектерден", "Целлюлозадан", "Майлардан ғана", "Крахмалдан"], "Оқулық бойынша вирус қабықшалары нәруызды бөлшектерден құрылған.", ["Целлюлоза – өсімдік жасуша қабырғасының заты.", "Қабықша нәруыздан құрылған; ірі вирустарда ғана мембрана бөліктері бар.", "Крахмал – қор зат."]]}, {"t": "g7s63", "g": 7, "q": ["Бактериофаг дегеніміз:", ["Бактерияларды зақымдайтын вирус", "Вирустарды зақымдайтын бактерия", "Ауру тудыратын бактерия", "Вирустарды жоятын зат"], "Бактериофагтар – бактерияларда паразиттік тіршілік ететін вирустар.", ["Керісінше: фаг – вирус, бактерия емес.", "Ауру тудыратын бактерия – патоген, фаг емес.", "Вирусты жоятын зат – дәрі, фаг емес."]]}, {"t": "g7s63", "g": 7, "q": ["Вирус тірі ағза ретінде қашан болады?", ["Тек зақымдаған жасуша ішінде", "Ауада", "Суда еркін жүргенде", "Топырақта"], "Жасушадан тыс вирус тіршілік қасиеттерін көрсетпейді.", ["Ауада вирус өспейді, көбеймейді.", "Суда да тіршілік белгісін көрсетпейді.", "Топырақта да жасушасыз көбеймейді."]]}, {"t": "g7s63", "g": 7, "q": ["Жасушадан тыс вирусқа тән:", ["Қоректенбейді, қозғалмайды, өспейді", "Белсенді қоректенеді", "Бөліну арқылы көбейеді", "Спора түзеді"], "Вирус жасушадан тыс тіршілікке тән қасиеттерді көрсетпейді.", ["Вирус жасушадан тыс қоректенбейді.", "Вирус бөлінбейді, ол жасуша ішінде құрастырылады.", "Спора – бактерияның тыныштық күйі."]]}, {"t": "g7s63", "g": 7, "q": ["Вирусқа ұқсас емес, ірі вирустардың нәруызды бетінде болатын құрылым:", ["Ие-жасуша мембранасының бөліктері", "Жасуша қабырғасы", "Талшықтар", "Хлоропласт"], "Ірі вирустар жасушадан шыққанда ие мембранасының бөліктерін алып кетеді.", ["Жасуша қабырғасы вируста жоқ.", "Талшықтар – бактерияның қозғалу мүшесі.", "Хлоропласт – өсімдік жасушасының органоиды."]]}, {"t": "g7s63", "g": 7, "q": ["Вируспен зақымданудың бірінші кезеңі:", ["Вирустың ие-жасуша мембранасына қосылуы", "Нуклеин қышқылын бүркуі", "Вирустардың құрастырылуы", "Жасушадан шығуы"], "Алдымен вирус жасуша мембранасына қосылады.", ["Бүрку – екінші кезең.", "Құрастыру – бесінші кезең.", "Шығу – алтыншы кезең."]]}, {"t": "g7s63", "g": 7, "q": ["Вирус ие-жасушаға не енгізеді?", ["Өз нуклеин қышқылын", "Нәруыз қабығын", "Рибосомаларын", "Митохондриясын"], "Вирус НҚ-ны цитоплазмаға бүркиді, қабығы сыртта қалады.", ["Қабық жасушадан тыс қалады.", "Вируста рибосома жоқ.", "Вируста митохондрия жоқ."]]}, {"t": "g7s63", "g": 7, "q": ["Зақымдаудың үшінші кезеңінде не болады?", ["Вирус НҚ