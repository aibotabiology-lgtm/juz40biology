{"k": "<article class=\"topic\" id=\"k7_54_1\"><h2><span class=\"n\">1</span>Гүл – жынысты көбею мүшесі</h2>\n<div class=\"two\"><div>\n<ul><li>Қосымша бөліктер: гүлсағақ, гүлтабан, тостаған жапырақшалар, күлтелер.</li><li>Басты бөліктер: <b>аталық</b> (тозаң – аталық жыныс жасушалары) және <b>аналық</b> (аналық жыныс жасушалары). Аналықтың жоғары бөлігі – аналық аузы.</li></ul>\n<p><b>Тозаңдану</b> – аналық аузына тозаңның түсуі. Одан кейін <b>ұрықтану</b> – дара хромосома жиынды гаметалардың қосылуы.</p>\n</div><figure><img src=\"data:image/webp;base64,\" alt=\"Гүлдің құрылысы: гүл сағағы, гүл табаны, тостағанша, күлте, аталық, аналық\" loading=\"lazy\"><figcaption>130-сурет. Гүлдің құрылысы: 1 – гүл сағағы; 2 – гүл табаны; 3 – тостағанша жапырақша; 4 – күлте; 5 – аталық; 6 – аналық</figcaption></figure></div>\n</article>\n<article class=\"topic\" id=\"k7_54_2\"><h2><span class=\"n\">2</span>Дара жынысты және қосжынысты гүлдер</h2>\n<div class=\"tbl\"><table><tr><th>Дара жынысты</th><th>Қосжынысты (гермафродит)</th></tr><tr><td>тек аталығы немесе тек аналығы бар</td><td>аталығы да, аналығы да бар</td></tr><tr><td>жүгері: ұшында – аталық, сабақ ортасында – аналық гүлдер</td><td>қызғалдақ, раушангүл, алма, өрік, шие, алмұрт</td></tr></table></div>\n</article>\n<article class=\"topic\" id=\"k7_54_3\"><h2><span class=\"n\">3</span>Айқас және өздігінен тозаңдану</h2>\n<div class=\"fn-grid\"><div class=\"fn\"><h3>Айқас</h3><p>бір гүл тозаңы басқа гүлдің аналық аузына түседі</p></div><div class=\"fn\"><h3>Өздігінен</h3><p>бір гүлдің ішінде аталықтан аналық аузына; сирек: егістік бұршақ, жержаңғақ, бидай</p></div></div>\n<figure><img src=\"data:image/webp;base64,\" alt=\"Өздігінен тозаңдану, айқас тозаңдану және жәндіктер арқылы айқас тозаңдану\" loading=\"lazy\"><figcaption>132-сурет. Тозаңдану түрлері</figcaption></figure>\n</article>\n<article class=\"topic\" id=\"k7_54_4\"><h2><span class=\"n\">4</span>Айқас тозаңдану әдістері</h2>\n<div class=\"tbl\"><table><tr><th>Әдіс</th><th>Бейімделу</th></tr><tr><td>Желмен</td><td>тозаң құрғақ, жеңіл, көп</td></tr><tr><td>Жәндіктермен</td><td>тозаң бұдыр, жабысқақ; гүл ашық түсті, хош иісті, тәтті шірнелі</td></tr><tr><td>Жануармен</td><td>тропиктік өсімдіктер – колибри</td></tr><tr><td>Сумен</td><td>су лалагүлі, тұңғиық: тозаңның іші қуыс, күлтеде «иірім»</td></tr></table></div>\n<div class=\"note\"><b>Есте сақта:</b> алдымен тозаңдану, содан кейін ұрықтану.</div>\n</article>", "cards": [["Гүл", "Гүлді өсімдіктің жынысты көбею мүшесі", "Гүл."], ["Гүл", "Гүлдің қосымша бөліктері", "Гүлсағақ, гүлтабан, тостаған жапырақшалар және күлтелер."], ["Гүл", "Гүлдің басты бөліктері", "Аталығы және аналығы."], ["Гүл", "Аталықта не түзіледі?", "Тозаң; онда аталық жыныс жасушалары бар."], ["Гүл", "Аналықта не болады?", "Аналық жыныс жасушалары."], ["Гүл", "Аналық аузы", "Аналықтың жоғары бөлігі; тозаң осыған түседі."], ["Тозаңдану", "Тозаңдану", "Аналық аузына тозаңның түсу үдерісі."], ["Тозаңдану", "Ұрықтану", "Тозаңданудан кейін жүретін жыныс жасушаларының – дара хромосома жиыны бар гаметалардың қосылуы."], ["Жыныс", "Дара жынысты гүлдер", "Тек аналықтары немесе тек аталықтары болатын гүлдер."], ["Жыныс", "Жүгерінің гүлдері", "Дара жынысты: жоғары ұшында аталық гүлдері, сабағының ортасында аналық гүлдері."], ["Жыныс", "Қосжынысты (гермафродит) өсімдіктер", "Гүлдерінде аталығы да, аналығы да болады."], ["Жыныс", "Гермафродит өсімдіктерге мысал", "Қызғалдақ, раушангүл, алма, өрік, шие, алмұрт."], ["Тозаңдану", "Айқас тозаңдану", "Бір гүл тозаңы басқа бір гүл аналығының аузына түседі."], ["Тозаңдану", "Өздігінен тозаңдану", "Тозаң бір гүлдің ішінде аталықтан аналық аузына түседі."], ["Тозаңдану", "Өздігінен тозаңдану табиғатта жиі ме?", "Жоқ, өсімдіктердің көпшілігінде гермафродитті гүл болса да, жиі кездеспейді."], ["Тозаңдану", "Өздігінен тозаңданатын өсімдіктер", "Егістік бұршақ, жержаңғақ және бидай."], ["Бейімделу", "Айқас тозаңдануға бейімделу", "Аналық аузы тозаң оңай қонатындай; тозаң біртегіс емес; тозаң көп, тозаңдану тәсілі әртүрлі."], ["Бейімделу", "Желмен тозаңдану", "Жел арқылы тозаңның тасымалдануы; тозаң құрғақ әрі жеңіл, көп болады."], ["Бейімделу", "Жәндіктермен тозаңдану", "Жәндіктер арқылы тозаңның тасымалдануы; тозаң бұдыр, жабысқақ."], ["Бейімделу", "Жәндіктер тозаңдандыратын гүлдердің белгілері", "Ашық түсті, хош иісті, тәтті шірне бөледі."], ["Бейімделу", "Жануар арқылы тозаңдану", "Кейбір тропиктік өсімдіктер, мысалы, колибри құсы арқылы."], ["Бейімделу", "Су арқылы тозаңдану", "Су лалагүлі, тұңғиық; тозаңы суға батпайтын іші қуыс, күлтеде ерекше «иірім» бар."]], "tf": [["Тозаңдану – аналық аузына тозаңның түсуі.", 1], ["Ұрықтану тозаңданудан бұрын жүреді.", 0], ["Гүлдің басты бөліктері – аталық пен аналық.", 1], ["Күлтелер гүлдің басты бөліктеріне жатады.", 0], ["Жүгерінің аталық гүлдері сабақтың жоғары ұшында орналасады.", 1], ["Алма мен шие – дара жынысты өсімдіктер.", 0], ["Бидай мен егістік бұршақ өздігінен тозаңданады.", 1], ["Табиғатта өздігінен тозаңдану айқас тозаңданудан жиі кездеседі.", 0], ["Желмен тозаңданатын өсімдіктердің тозаңы құрғақ әрі жеңіл.", 1], ["Жәндіктермен тозаңданатын гүлдердің тозаңы тегіс әрі құрғақ болады.", 0], ["Кейбір тропиктік өсімдіктерді колибри құсы тозаңдандырады.", 1], ["Су арқылы тозаңданатын өсімдіктердің тозаңы суға тез батады.", 0]], "qx": {"s": [["Гүлді өсімдіктің жынысты көбею мүшесі:", ["Гүл", "Тамыр", "Жапырақ", "Сабақ"], "Гүл – гүлді өсімдіктің жынысты көбею мүшесі.", ["Тамыр – вегетативті мүше.", "Жапырақ – вегетативті мүше.", "Сабақ – вегетативті мүше."]], ["Гүлдің басты бөліктері:", ["Аталық және аналық", "Күлте және тостағанша", "Гүлсағақ және гүлтабан", "Тостағанша және гүлтабан"], "Аталық пен аналықта жыныс жасушалары түзіледі, сондықтан олар басты бөліктер.", ["Күлте мен тостағанша – қосымша бөліктер.", "Гүлсағақ пен гүлтабан – қосымша бөліктер.", "Тостағанша мен гүлтабан – қосымша бөліктер."]], ["Аналықтың жоғары бөлігі:", ["Аналық аузы", "Түйін", "Гүлтабан", "Тозаңдық"], "Аналықтың жоғары бөлігі – аналық аузы, оған тозаң түседі.", ["Түйін – аналықтың кеңейген төменгі бөлігі.", "Гүлтабан – гүлдің қосымша бөлігі.", "Тозаңдық – аталықтың бөлігі."]], ["Аналық аузына тозаңның түсу үдерісі:", ["Тозаңдану", "Ұрықтану", "Телу", "Бүршіктену"], "Бұл – тозаңданудың анықтамасы.", ["Ұрықтану – гаметалардың қосылуы, ол тозаңданудан кейін жүреді.", "Телу – өсімдік бөлігін басқа өсімдікке қондыру.", "Бүршіктену – жыныссыз көбею тәсілі."]], ["Тек аналықтары немесе тек аталықтары бар гүлдер:", ["Дара жынысты", "Қосжынысты", "Гермафродит", "Толық гүлдер"], "Мұндай гүлдер дара жынысты деп аталады.", ["Қосжынысты гүлде екеуі де болады.", "Гермафродит – қосжыныстының басқа атауы.", "«Толық гүл» оқулықта бұл мағынада қолданылмайды."]], ["Дара жынысты гүлдері бар өсімдік:", ["Жүгері", "Қызғалдақ", "Раушангүл", "Алма"], "Жүгерінің аталық гүлдері жоғарыда, аналық гүлдері сабақтың ортасында.", ["Қызғалдақ – гермафродит.", "Раушангүл – гермафродит.", "Алма – гермафродит."]], ["Жүгерінің аналық гүлдері қайда орналасады?", ["Сабағының ортасында", "Сабағының жоғары ұшында", "Тамырында", "Жапырақ ұшында"], "Оқулық бойынша аналық гүлдер сабақтың ортасында пайда болады.", ["Жоғары ұшында аталық гүлдері орналасады.", "Тамырда гүл болмайды.", "Жапырақ ұшында гүл түзілмейді."]], ["Бір гүлдің тозаңы басқа гүл аналығының аузына түседі:", ["Айқас тозаңдану", "Өздігінен тозаңдану", "Ұрықтану", "Партеногенез"], "Бұл – айқас тозаңданудың анықтамасы.", ["Өздігінен тозаңдануда тозаң бір гүлдің ішінде түседі.", "Ұрықтану – гаметалардың қосылуы.", "Партеногенезде ұрықтану жүрмейді."]], ["Өздігінен тозаңданатын өсімдік:", ["Бидай", "Жүгері", "Су лалагүлі", "Алма"], "Оқулықта егістік бұршақ, жержаңғақ, бидай өздігінен тозаңданатыны айтылған.", ["Жүгері – дара жынысты, айқас тозаңданады.", "Су лалагүлі су арқылы тозаңданады.", "Алма өздігінен тозаңданатындар қатарында аталмайды."]], ["Желмен тозаңданатын өсімдіктің тозаңы:", ["Құрғақ, жеңіл және көп", "Бұдыр және жабысқақ", "Іші қуыс, суға батпайды", "Аз және ауыр"], "Желмен тозаңданатын өсімдіктерде құрғақ әрі жеңіл тозаң көп болады.", ["Бұдыр, жабысқақ тозаң – жәндіктермен тозаңдануға тән.", "Іші қуыс тозаң – су арқылы тозаңдануға тән.", "Ауыр тозаңды жел тасымалдай алмайды."]], ["Жәндіктер тозаңдандыратын гүлдің белгісі:", ["Ашық түсті, хош иісті, тәтті шірнелі", "Көрімсіз, иіссіз", "Тозаңы құрғақ, жеңіл", "Күлтесінде «иірімі» бар"], "Мұндай гүлдер жәндіктерді түсімен, иісімен, шірнесімен тартады.", ["Көрімсіз, иіссіз гүлдер жәндіктерді тартпайды.", "Құрғақ, жеңіл тозаң желмен тозаңдануға тән.", "«Иірім» су арқылы тозаңданатын гүлдерде болады."]], ["Жәндіктермен тозаңданатын өсімдіктің тозаңы неге бұдыр, жабысқақ?", ["Жәндік денесіне оңай жабысу үшін", "Желмен ұшу үшін", "Суда жүзу үшін", "Ауыр болу үшін"], "Тозаң жәндік денесіне оңай жабысуы үшін бұдыр, жабысқақ болады.", ["Желмен ұшатын тозаң құрғақ, жеңіл.", "Суда жүзетін тозаңның іші қуыс.", "Тозаңның ауырлығы бейімделу емес."]], ["Су арқылы тозаңданатын өсімдік:", ["Тұңғиық", "Бидай", "Жүгері", "Шие"], "Су лалагүлі мен тұңғиық су арқылы тозаңданады.", ["Бидай өздігінен тозаңданады.", "Жүгері желмен (айқас) тозаңданады.", "Шие – гермафродит құрлық өсімдігі."]], ["Колибри құсы арқылы тозаңдану – бұл:", ["Жануар арқылы тозаңдану", "Желмен тозаңдану", "Өздігінен тозаңдану", "Су арқылы тозаңдану"], "Кейбір тропиктік өсімдіктер жануар, мысалы, колибри арқылы тозаңданады.", ["Колибри – жел емес, жануар.", "Өздігінен тозаңдану бір гүлдің ішінде жүреді.", "Су арқылы тозаңдану су өсімдіктеріне тән."]], ["Тозаңданудан кейін жүруі тиіс үдеріс:", ["Ұрықтану", "Мейоз", "Гүлдеу", "Вегетативті көбею"], "Тозаңдану сәтті аяқталған соң ұрықтану жүруі керек.", ["Мейоз гаметалар түзілгенде жүреді, тозаңданудан кейінгі қадам емес.", "Гүлдеу тозаңданудан бұрын болады.", "Вегетативті көбею тозаңданумен байланысты емес."]]], "m": [["Гүлдің қосымша бөліктерін таңдаңыз.", ["Гүлсағақ", "Аталық", "Аналық", "Гүлтабан", "Күлте", "Аналық аузы"], [0, 3, 4], ["Дұрыс: гүлсағақ – қ