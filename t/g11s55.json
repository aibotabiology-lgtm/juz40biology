, ["Тышқан антиденесі адамда иммундық жауап тудырады", "Иммундау қажет", "Ұқсас нәруыздарды ажырататын антидене алу қиын", "Антидене мөлшері шектеулі", "Антидене бірнеше детерминантқа бағытталады", "Гибридома өлмейді"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Керісінше, шексіз мөлшер алынады.", "Бір детерминантқа.", "Бұл артықшылық."]], ["Гендік инженерия мүмкіндіктері:", ["V және C бөліктерін сынауықта біріктіру", "Мутациялар енгізу", "Бактерияларда экспрессиялау", "Тышқанды міндетті иммундау", "Плазмоцитома қолдану міндетті", "ГАТ-ортада іріктеу"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Иммундаусыз жүреді.", "Қажет емес.", "Гибридома әдісі."]], ["Убиквитин мысалына қатысты дұрыс тұжырымдар:", ["K63-полимерлер сигнал беруге қажет", "A20 K63-ті K48-ке ауыстырады", "K48-байланысты кешен протеасомада ыдырайды", "K48 сигнал платформасын түзеді", "Убиквитин – ДНҚ", "Процесс 10 сағатқа созылады"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "K63 түзеді.", "Нәруыз.", "Минуттар."]]], "x": [["Сәйкестендіріңіз: құрылым – құрамы", ["Ауыр тізбек", "Жеңіл тізбек", "Fab-фрагмент"], ["VH + CH₁, CH₂, CH₃", "VL + CL", "Вариабельді + тұрақты домен, дисульфидті байланыс", "Тек CH₂ және CH₃", "Төрт вариабельді домен"], [0, 1, 2], ["H тізбек.", "L тізбек.", "Fab."], "CH₂, CH₃ – Fc бөлігі (Fab емес)."], ["Сәйкестендіріңіз: ұғым – мәні", ["Аффиндік жетілу", "Фаг-дисплей кітапханасы", "A20"], ["Мутациялар арқылы арнайылықтың артуы", "Иммундаусыз антидене іріктеу", "K63-ті K48-ке ауыстыратын деубиквитиназа", "Жасушаларды біріктіретін зат", "Нуклеотид синтезін тежегіш"], [0, 1, 2], ["Жетілу.", "Кітапхана.", "Фермент."], "Біріктіргіш – ПЭГ, тежегіш – аминоптерин."]]}, "toc": [["k11_55_1", "Антидене құрылысы"], ["k11_55_2", "Гибридома әдісінің шектеулері"], ["k11_55_3", "Иммундаусыз антидене алу"]], "cats": {"Құрылыс": "Антидене құрылысы", "Мәселе": "Гибридома әдісінің шектеулері", "Жаңа": "Жаңа технологиялар"}}