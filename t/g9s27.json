{"k": "<article class=\"topic\" id=\"k9_27_1\"><h2><span class=\"n\">1</span>Гомеостаз</h2>\n<div class=\"two\"><div>\n<ul class=\"tree\">\n<li><b>Гомеостаз</b> — ішкі орта тұрақтылығын сақтау қабілеті</li>\n<li><b>Ішкі орта</b> — қан, лимфа, ұлпа сұйықтығы</li>\n<li><b>Динамикалық тепе-теңдік</b> — көрсеткіштердің шамалы ауытқуы<ul><li>қан: 55% плазма, 45% жасуша; ауытқу ≤5%</li></ul></li>\n<li><b>Белгілері</b> — температура, глюкоза, тұз, нәруыз, иондар, қысым, жүрек соғу ырғағы</li>\n</ul>\n</div><figure><img src=\"data:image/webp;base64,\" alt=\"Гомеостаздың сызбасы\" loading=\"lazy\"><figcaption>Гомеостаздың сызбасы</figcaption></figure></div>\n</article>\n<article class=\"topic\" id=\"k9_27_2\"><h2><span class=\"n\">2</span>Нейрогуморальды механизм</h2>\n<div class=\"flow\"><div><b>Ми қыртысы</b><span>сезім мүшелерінен ақпарат</span></div><i>→</i><div><b>Гипоталамус</b><span>нейрогормондар</span></div><i>→</i><div><b>Гипофиз</b><span>гормондар</span></div><i>→</i><div><b>Ішкі секреция бездері</b><span>ұйқы безінен басқа</span></div></div>\n<ul class=\"tree\">\n<li><b>Вегетативті жүйке</b> — симпатикалық (белсенді), парасимпатикалық (енжар)</li>\n<li><b>Кері байланыс</b> — гормон қан арқылы миға жетеді<ul><li>гормон жетпесе → бөлу бұйрығы</li><li>артық болса → азайту бұйрығы</li></ul></li>\n</ul>\n</article>\n<article class=\"topic\" id=\"k9_27_3\"><h2><span class=\"n\">3</span>Температура реттелуі</h2>\n<div class=\"two\"><div>\n<div class=\"flow\"><div><b>Суық рецепторлары</b><span>гипоталамусқа сигнал</span></div><i>→</i><div><b>Симпатикалық жүйе</b><span>тамыр тарылады, қалтырау</span></div><i>→</i><div><b>Бүйрекүсті безі</b><span>адреналин</span></div><i>→</i><div><b>Катаболизм</b><span>жылу бөлінеді</span></div></div>\n<ul class=\"tree\">\n<li><b>Гипофиз → ТТГ</b> — қалқанша без → тироксин</li>\n<li><b>Гипофиз → АКТГ</b> — бүйрекүсті безі → глюкокортикостероидтар</li>\n<li><b>Қызғанда</b> — тері капиллярлары кеңейеді, тер бөлінеді</li>\n</ul>\n</div><figure><img src=\"data:image/webp;base64,\" alt=\"Жылу реттеудің сызбасы\" loading=\"lazy\"><figcaption>Жылу реттеу сызбасы</figcaption></figure></div>\n</article>\n<article class=\"topic\" id=\"k9_27_4\"><h2><span class=\"n\">4</span>Глюкоза реттелуі</h2>\n<div class=\"tbl\"><table><thead><tr><th>Гормон</th><th>Безі</th><th>Әсері</th></tr></thead><tbody>\n<tr><td><b>Инсулин</b></td><td>ұйқы безі</td><td>қандағы глюкоза → бауырдағы гликоген</td></tr>\n<tr><td><b>Глюкагон</b></td><td>ұйқы безі</td><td>гликоген → қандағы глюкоза</td></tr>\n<tr><td><b>Адреналин</b></td><td>бүйрекүсті безі</td><td>гликоген → қандағы глюкоза</td></tr>\n</tbody></table></div>\n<div class=\"note\"><b>Есте сақта:</b> гомеостазға ұмтылу – тірі ағзаның даусыз белгісі.</div>\n</article>", "cards": [["Ұғым", "Гомеостаз (тар мағынада)", "Адам ағзасының өз ішкі ортасының тұрақтылығын сақтау қабілеті."], ["Ұғым", "Гомеостаздың кең мағынасы", "Термин биосфералық мағынада да, жеке ағзаға қатысты да қолданылады."], ["Ұғым", "Ішкі орта неге тұрақты болуы керек?", "Қан, лимфа немесе ұлпа сұйықтығының құрамы елеулі өзгерсе, тіршілік жойылады."], ["Ұғым", "Динамикалық тепе-теңдік", "Кейбір көрсеткіштердің шамалы өзгеруі; ағзаның қоршаған жағдай өзгерісіне бейімделуі үшін қажет."], ["Ұғым", "Плазма мен жасушалардың арақатынасы", "Қалыпты жағдайда 55% плазма : 45% жасуша; 5% шегінде өзгеруі мүмкін."], ["Ұғым", "Гомеостаз белгілері", "Дене температурасы; плазмадағы глюкоза, тұздар, нәруыздар, иондар, несепнәр, зәр қышқылы мөлшері; артериялық қысым; тыныс алу мен жүрек соғуының ырғағы."], ["Ұғым", "Гомеостазды сақтауға ұмтылу", "Тірі ағзаның даусыз белгісі; механизмі өсімдіктерде, біржасушалыларда және жоғары сатыдағы ағзаларда әртүрлі."], ["Механизм", "Гомеостазды сақтау механизмі", "Нейрогуморальды – жүйке және эндокриндік жүйелердің тікелей өзара әсері."], ["Механизм", "Ішкі секреция бездерін не басқарады?", "Гипофиз гормондары – ұйқы безінен басқа барлық безді."], ["Механизм", "Гипофиз неге бағынады?", "Жүйке ұштарына және гипоталамус нейрогормондарына."], ["Механизм", "Гипоталамус", "Аралық мидың бөлімі; нейрогормондар арқылы гипофизді басқарады."], ["Механизм", "Үлкен ми сыңарлары қыртысының рөлі", "Сезім мүшелерінен ақпаратты қабылдап, талдайды; гипоталамусқа және вегетативті жүйке жүйесінің бөлімдеріне әсер етеді."], ["Механизм", "Вегетативті жүйке жүйесінің бөлімдері", "Белсенді – симпатикалық, енжар – парасимпатикалық."], ["Механизм", "«Кері байланыс» ұстанымы", "Гормондар мен заттар қан арқылы миға жетіп әсер етеді; рецепторлардан «мақсат орындалды ма» деген ақпарат талданады."], ["Механизм", "Әрекет тиімділігінің мониторингі", "Гормон жетпесе – бөлуге, артық болса – азайтуға бұйрық беріледі."], ["Жылу", "Жылу реттеу қайдан басталады?", "Суықты қабылдайтын рецепторлардан ОЖЖ-ге – гипоталамусқа."], ["Жылу", "Симпатикалық-адреналинді жүйенің жауабы", "Тамырлардың тарылуы, қалтырау; бүйрекүсті безінен адреналин бөлінеді."], ["Жылу", "ТТГ", "Гипофиз гормоны; қалқанша безді стимулдап, тироксин бөлдіреді."], ["Жылу", "АКТГ суықта", "Бүйрекүсті безінен глюкокортикостероидтарды бөлдіреді."], ["Жылу", "Катаболизм", "Адреналин, тироксин және глюкокортикостероидтар әсерінен күшейіп, жылу береді."], ["Жылу", "Ағза қызғанда", "Тері капиллярлары кеңейеді және тер бөлінеді."], ["Жылу", "Тері тамырларының тарылуы", "Жылыну үшін тарылады; ағза жылынғанда қалыпты диаметрге дереу кеңейеді."], ["Глюкоза", "Инсулин", "Ұйқы безінің гормоны; қандағы глюкозаны бауырдағы гликогенге айналдырады."], ["Глюкоза", "Глюкагон", "Ұйқы безінің гормоны; бауырдағы гликогенді қандағы глюкозаға айналдырады."], ["Глюкоза", "Адреналиннің глюкозаға әсері", "Бүйрекүсті безінің гормоны; гликогеннің глюкозаға айналуын күшейтеді."], ["Глюкоза", "Глюкоза реттелуіндегі жүйке жүйесі", "Гипоталамус пен симпатикалық бөлім бүйрекүсті безін іске қосады; глюкоза бұлшық еттердің жиырылуына жұмсалады."]], "tf": [["Гомеостаз – ағзаның ішкі ортасының тұрақтылығын сақтау қабілеті.", 1], ["Гомеостаз кезінде ағзаның барлық көрсеткіштері мүлде өзгермейді.", 0], ["Динамикалық тепе-теңдік ағзаның орта өзгерісіне бейімделуіне қажет.", 1], ["Гомеостазды сақтау механизмі – тек жүйкелік, гормондар қатыспайды.", 0], ["Гипофиз гормондары ұйқы безінен басқа ішкі секрецияның барлық безін басқарады.", 1], ["Гипоталамус гипофизге бағынады және оның нейрогормондарымен басқарылады.", 0], ["Гормондар қан арқылы миға жетіп, кері байланыс ұстанымы бойынша әсер етеді.", 1], ["Гормон артық болғанда оның бөлінуін көбейтуге бұйрық беріледі.", 0], ["Суықта тері тамырлары тарылып, қалтырау пайда болады.", 1], ["Ағза қызып кеткенде тері капиллярлары тарылып, тер бөлінуі тоқтайды.", 0], ["Тироксин мен адреналин катаболизмді күшейтіп, жылу түзілуіне әсер етеді.", 1], ["Инсулин бауырдағы гликогенді қандағы глюкозаға айналдырады.", 0], ["Глюкагон мен адреналин гликогеннің глюкозаға айналуын күшейтеді.", 1], ["Гомеостазды сақтау механизмі өсімдіктерде, біржасушалыларда және адамда бірдей.", 0]], "qx": {"s": [["Гомеостаз (тар мағынада) дегеніміз:", ["Ағзаның ішкі ортасының тұрақтылығын сақтау қабілеті", "Ағзаның өсуі", "Ағзаның көбеюі", "Сыртқы ортаның өзгеруі"], "Гомеостаз – ішкі ортаның тұрақтылығын сақтау қабілеті.", ["Өсу – басқа тіршілік үдерісі.", "Көбею гомеостаз емес.", "Сыртқы орта өзгерісіне ағза бейімделеді, ол гомеостаздың өзі емес."]], ["Неге ағза ішкі ортасының құрамы тұрақты болмаса тіршілік ете алмайды?", ["Қан, лимфа, ұлпа сұйықтығы құрамы елеулі өзгерсе, тіршілік жойылады", "Ішкі орта тек сыртқы ортаға тәуелсіз", "Ағзада сұйықтық жоқ", "Тұрақтылық тек өсімдіктерге керек"], "Оқулық бойынша ішкі орта құрамының елеулі өзгерісі тіршілікті жоюға апарады.", ["Ішкі орта сыртқы ортамен байланысты (39-сурет).", "Ағзада қан, лимфа, ұлпа сұйықтығы бар.", "Гомеостаз барлық тірі ағзаға тән."]], ["Динамикалық тепе-теңдік дегеніміз:", ["Көрсеткіштердің шамалы өзгеруі", "Көрсеткіштердің мүлде өзгермеуі", "Көрсеткіштердің шектен тыс өзгеруі", "Ағзаның тіршілігінің тоқтауы"], "Кейбір көрсеткіштердің шамалы өзгеруі – динамикалық тепе-теңдік; ол бейімделуге қажет.", ["Мүлде өзгермеу бейімделуге мүмкіндік бермейді.", "Шектен тыс өзгеріс гомеостаздың бұзылуы.", "Тіршіліктің тоқтауы тепе-теңдік емес."]], ["Адам ағзасында гомеостазды сақтау механизмі:", ["Нейрогуморальды", "Тек жүйкелік", "Тек гуморальды", "Тек механикалық"], "Гомеостаз жүйке және эндокриндік жүйелердің тікелей өзара әсерімен сақталады.", ["Гормондар да қатысады.", "Жүйке жүйесі де қатысады.", "Механикалық механизм аталмайды."]], ["Гипофиз гормондары басқармайтын ішкі секреция безі:", ["Ұйқы безі", "Қалқанша без", "Бүйрекүсті безі", "Жыныс бездері"], "Оқулық бойынша ұйқы безінен басқа барлық безді гипофиз гормондары басқарады.", ["Қалқанша безді гипофиз ТТГ арқылы басқарады.", "Бүйрекүсті безін гипофиз АКТГ арқылы басқарады.", "Жыныс бездері де гипофиз бақылауында – ерекшелік тек ұйқы безі."]], ["Гипофиз неге бағынады?", ["Жүйке ұштарына және гипоталамус нейрогормондарына", "Қалқанша безге", "Ұйқы безіне", "Бүйрекүсті безіне"], "Гипофиз жүйке ұштары мен аралық ми бөлімі – гипоталамустың нейрогормондарына бағынады.", ["Қалқанша без гипофизге бағынады, керісінше емес.", "Ұйқы безі гипофизді басқармайды.", "Бүйрекүсті безін гипофиз басқарады."]], ["Гипоталамус мидың қай бөліміне жатады?", ["Аралық ми", "Сопақша ми", "Мишық", "Ортаңғы ми"], "Гипоталамус – аралық ми бөлімі.", ["Сопақша мида тыныс алу орталығы бар.", "Мишық қимыл үйлесімін реттейді.", "Ортаңғы ми гипоталамусты қамтымайды."]], ["«Кері байланыс» ұстанымы бойынша не болады?", ["Гормондар қан арқылы миға жетіп, оның бұйрықтарына әсер етеді", "Ми гормондарды тек сыртқа шығарады", "Гормон бөлінуі ешқашан өзгермейді", "Рецепторлар жұмыс істемейді"], "Гормондар қанмен миға, гипоталамусқа жетіп, мақсат орындалғаны туралы ақпарат беріледі.", ["Ми ақпаратты қабылдап, бұйрықты түзетеді.", "Гормон жетпесе – көбейеді, артық болса – азаяды.", "Рецепторлардан ақпарат талданады."]], ["Қанда гормон артық болғанда ағза қалай жауап береді?", ["Оның бөлінуін азайтуға бұйр