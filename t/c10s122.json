іру", "Элонгация"], ["90–97 °C", "50–60 °C", "72 °C", "0 °C", "120 °C"], [0, 1, 2], ["ДНҚ ажырайды.", "Праймерлер қосылады.", "Taq-полимераза оптимумы."], "Тым төмен не тым жоғары температурада ПТР жүрмейді."], ["Сәйкестендіріңіз: компонент – қызметі", ["Праймер", "Taq-полимераза", "дНТФ"], ["Синтезді бастайды", "Жаңа тізбекті түзеді", "Құрылыс материалы", "ДНҚ-ны кеседі", "Ортаны қыздырады"], [0, 1, 2], ["Олигонуклеотид.", "Термотұрақты фермент.", "Нуклеотидтер."], "ДНҚ-ны рестриктаза кеседі; қыздыруды термоциклер жасайды."]]}, "toc": [["k10_122_1", "ПТР дегеніміз не"], ["k10_122_2", "Реакциялық қоспа"], ["k10_122_3", "Бір циклдің кезеңдері"]], "cats": {"Негіз": "ПТР негіздері", "Қоспа": "Реакциялық қоспа", "Кезең": "ПТР кезеңдері", "Қолдану": "Қолданылуы"}}