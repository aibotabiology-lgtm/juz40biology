і.", "Пияз — даражарнақты, жүйкеленуі параллель."]], ["Негізгі тамырын ажырату мүмкін емес, шашақ тамыр жүйелі өсімдікті таңдаңыз.", ["Қайың", "Үрмебұршақ", "Раушангүл", "Жержаңғақ", "Бидай", "Асқабақ"], [4], ["Қайың — қосжарнақты, кіндік тамыр жүйесі бар.", "Үрмебұршақ — қосжарнақты, кіндік тамырлы.", "Раушангүл — қосжарнақты, кіндік тамыр жүйесі бар.", "Жержаңғақ — қосжарнақты, кіндік тамырлы.", "Дұрыс: бидай — даражарнақты, тамыр жүйесі шашақ.", "Асқабақ — қосжарнақты, тамыры кіндік тамыр жүйесі."]], ["Үшқұлақ-күрделі жапырағы бар өсімдікті таңдаңыз.", ["Акация", "Талшын", "Құлпынай", "Алма", "Бөртегүл", "Бұршақ"], [2], ["Акация жапырағы қауырсын-күрделі.", "Талшын жапырағы күрделі-саусақты.", "Дұрыс: құлпынай (беде сияқты) үшқұлақ-күрделі жапырақты.", "Алма жапырағы жай.", "Бөртегүл жапырағы жай.", "Бұршақ жапырағы қауырсын-күрделі."]]], "x": [["Сәйкестендіріңіз: күрделі жапырақ типі — өсімдік", ["Қауырсын-күрделі", "Күрделі-саусақты", "Үшқұлақ-күрделі"], ["Талшын", "Қайың", "Беде", "Акация", "Қызғалдақ"], [3, 0, 2], ["Акацияның (бұршақтың да) жапырағы қауырсын-күрделі.", "Талшынның жапырақшалары бір нүктеден саусақтай тарайды.", "Беде жапырағы үш жапырақшадан тұрады."], "Қайыңның жапырағы жай; қызғалдақ даражарнақты, оның жапырағы ешқашан күрделі болмайды."], ["Сәйкестендіріңіз: даражарнақтылардың белгісі — типі", ["Тамыр жүйесі", "Жүйкелену", "Гүлсерік"], ["Кіндік", "Жай", "Шашақ", "Қосарлы", "Параллель не доғатәрізді"], [2, 4, 1], ["Даражарнақтыларда негізгі тамыр ажыратылмайды — шашақ тамыр жүйесі.", "Даражарнақтылар жапырағы параллель не доғатәрізді жүйкеленеді.", "Тостаған жапырақшалары болмағандықтан гүлсерік жай."], "Кіндік тамыр жүйесі мен қосарлы гүлсерік — қосжарнақтылардың белгілері."], ["Сәйкестендіріңіз: өсімдік — класы мен тіршілік формасы", ["Пальма", "Емен", "Қызғалдақ"], ["Қосжарнақты шөп", "Даражарнақты ағаш", "Қылқанжапырақты ағаш", "Даражарнақты шөп", "Қосжарнақты ағаш"], [1, 4, 3], ["Пальма — ағаш болатын жалғыз даражарнақтылар тобы.", "Емен — камбийі бар қосжарнақты ағаш.", "Қызғалдақ — лалагүлділер тұқымдасының даражарнақты шөбі."], "Қылқанжапырақтылар гүлді өсімдіктерге жатпайды; қосжарнақты шөп мысалы ретінде бұл үшеуінің ешқайсысы сай емес."]]}, "toc": [["k8_8_1", "Екі класс, тұқым"], ["k8_8_2", "Тамыр, жапырақ, гүл"], ["k8_8_3", "Салыстыру"]], "cats": {"Тұқым": "Тұқым құрылысы", "Мүше": "Тамыр мен жапырақ", "Гүл": "Гүл құрылысы", "Форма": "Тіршілік формасы мен мысалдар"}}