{"k": "<article class=\"topic\" id=\"k10_40_1\"><h2><span class=\"n\">1</span>АТФ құрылысы</h2>\n<div class=\"two\"><div>\n<ul class=\"tree\">\n<li><b>АТФ</b> — жасушаның негізгі энергия көзі</li>\n<li><b>Нуклеотид</b><ul><li>аденин</li><li>рибоза</li><li>3 фосфор қышқылы қалдығы</li></ul></li>\n<li><b>Макроэргиялық байланыс (~)</b> — фосфаттар арасында</li>\n<li><b>Ф. Липман</b> — терминді енгізген</li>\n<li><b>Тұрақсыз</b> — ферментпен оңай гидролизденеді</li>\n</ul>\n<div class=\"numbers\"><div><b>0,04%</b><span>жасушадағы мөлшері</span></div><div><b>0,2–0,5%</b><span>қаңқа бұлшықетінде</span></div></div>\n</div><figure><img src=\"data:image/webp;base64,\" alt=\"АТФ құрылымы\" loading=\"lazy\"><figcaption>АТФ құрылымы</figcaption></figure></div>\n</article>\n<article class=\"topic\" id=\"k10_40_2\"><h2><span class=\"n\">2</span>Гидролиз және қызметі</h2>\n<div class=\"flow\"><div><b>АТФ</b><span>+ Н₂О, фермент</span></div><i>→</i><div><b>АДФ + Н₃РО₄</b><span>30,6 кДж/моль</span></div><i>→</i><div><b>АМФ</b><span>2-фосфат бөлінді</span></div></div>\n<ul class=\"tree\">\n<li><b>Энергия аккумуляторы</b> — АДФ + Ф → АТФ энергия сіңіреді</li>\n<li><b>Түзілуі</b> — органикалық заттар тотығуында (≥ 30,6 кДж/моль)</li>\n<li><b>Жұмсалуы</b><ul><li>қозғалыс, жүрек соғуы</li><li>органикалық заттар синтезі</li><li>заттарды сіңіру, бөлу</li><li>дене жылуы, биоэлектрлік импульс</li></ul></li>\n<li><b>Қоры аз</b> — бұлшықетте 20–30 жиырылуға жетеді</li>\n<li><b>Энергия қоры</b> — май, гликоген (бауырда)</li>\n</ul>\n<div class=\"note\"><b>Есте сақта:</b> АТФ ⇄ АДФ + Ф айналымы үздіксіз қайталанады.</div>\n</article>", "cards": [["Құрылыс", "АТФ", "Аденозинүшфосфор қышқылы (аденозинүшфосфат) – жасушаның негізгі энергия көздерінің бірі."], ["Құрылыс", "АТФ қай жасушаларда болады?", "Өсімдіктер мен жануарлардың барлық жасушасында."], ["Құрылыс", "Жасушадағы АТФ мөлшері", "Орташа 0,04% (шикі массадан); ең көбі қаңқа бұлшықеттерінде – 0,2–0,5%."], ["Құрылыс", "АТФ химиялық табиғаты", "Нуклеотид: азотты негіз – аденин, көмірсу – рибоза және фосфор қышқылы."], ["Құрылыс", "АТФ-тің кәдімгі нуклеотидтен айырмашылығы", "Фосфор қышқылының бір қалдығының орнына үш қалдығы болады."], ["Құрылыс", "Макроэргиялық байланыстар", "АТФ-тегі фосфат топтары арасындағы көп энергия алып жүретін байланыстар; үзілгенде энергия босайды."], ["Құрылыс", "«Макроэргиялық байланыс» терминін кім енгізді?", "Ф. Липман; оларды (~) белгісімен белгілеуді ұсынды."], ["Құрылыс", "АТФ молекуласында неше макроэргиялық байланыс бар?", "Екі – үш фосфат қалдығы арасында (98-сурет)."], ["Гидролиз", "АТФ гидролизі", "Ерекше ферменттер әсерінен су қосып ыдырауы: АТФ + Н₂О → АДФ + Н₃РО₄."], ["Гидролиз", "АДФ", "Аденозиндифосфат – АТФ-тен соңғы (үшінші) фосфат қалдығы бөлінгенде түзіледі."], ["Гидролиз", "АМФ", "Аденозинмонофосфат – екінші фосфат қалдығы бөлінгенде түзіледі."], ["Гидролиз", "АТФ гидролизінің пайдалы жұмысы", "Тұрақты қысым мен температурада шамамен 30,6 кДж/моль."], ["Гидролиз", "АТФ неге энергия аккумуляторы?", "АДФ пен фосфаттан АТФ түзілгенде энергия сіңіріліп жинақталады, гидролизде босайды."], ["Гидролиз", "АТФ қандай реакцияларда түзіледі?", "Энергия шығымы 30,6 кДж/моль және одан артық болатын реакцияларда, мысалы органикалық қосылыстардың тотығуында."], ["Гидролиз", "АТФ-ке жинақталмаған энергия", "Жылу түрінде шашырайды."], ["Гидролиз", "АТФ молекуласының тұрақсыздығы", "Ерекше ферменттер әсерінен оңай гидролизденеді."], ["Қызмет", "АТФ – әмбебап энергия көзі", "Химиялық энергияны жасушаның кез келген бөлігіне тасымалдай алады; энергия қажет болса АТФ гидролизденеді."], ["Қызмет", "АТФ энергиясы не үшін жұмсалады?", "Жасуша қозғалысына, органикалық заттар синтезіне, заттарды сіңіру мен бөліп шығаруға, дене жылуына, жүрек соғуына, биоэлектрлік импульстерге."], ["Қызмет", "Бұлшықеттегі АТФ қоры", "Тек 20–30 жиырылуға жетеді, ал бұлшықет сағаттап мың рет жиырыла алады – сондықтан АТФ үздіксіз синтезделеді."], ["Қызмет", "Организмдегі энергия қоры", "Май және гликоген (гликоген бауырда жиналады)."], ["Қызмет", "АТФ айналымы", "АТФ → АДФ + Ф (энергия бөлінеді) → май немесе көмірсу тотығу энергиясы есебінен қайта синтезделеді; сансыз рет қайталанады."], ["Қызмет", "АТФ реакцияға тікелей түсе ме?", "Сирек түседі; процестерге оның химиялық байланыстарындағы энергия қажет."]], "tf": [["АТФ өсімдіктер мен жануарлардың барлық жасушасында болады.", 1], ["АТФ химиялық табиғаты бойынша нуклеотидтерге жатады.", 1], ["АТФ құрамындағы көмірсу – дезоксирибоза.", 0], ["«Макроэргиялық байланыстар» терминін Ф. Липман енгізді.", 1], ["Макроэргиялық байланыстар аденин мен рибоза арасында түзіледі.", 0], ["АТФ-тен соңғы фосфат қалдығы бөлінгенде АДФ түзіледі.", 1], ["АТФ-тен екінші фосфат қалдығы бөлінгенде АДФ түзіледі.", 0], ["АТФ-ке жинақталмаған энергия жылу түрінде шашырайды.", 1], ["Гликоген бауырда жиналып, энергия қоры қызметін атқарады.", 1]], "qx": {"s": [["АТФ молекуласының құрамына кіреді:", ["Аденин, рибоза, үш фосфор қышқылының қалдығы", "Аденин, дезоксирибоза, бір фосфат", "Гуанин, рибоза, үш фосфат", "Аденин, глюкоза, екі фосфат"], "АТФ – нуклеотид: аденин, рибоза және фосфор қышқылының үш қалдығы.", ["Дезоксирибоза ДНҚ нуклеотидтеріне тән, ал бір фосфат – кәдімгі нуклеотид.", "АТФ-тің азотты негізі – аденин, гуанин емес.", "АТФ-те көмірсу – рибоза, фосфат саны – үшеу."]], ["АТФ-тің кәдімгі нуклеотидтен айырмашылығы:", ["Бір фосфат қалдығының орнына үшеуі болады", "Азотты негізі болмайды", "Көмірсуы алты көміртекті", "Құрамында күкірт бар"], "Кәдімгі нуклеотидте бір, АТФ-те үш фосфор қышқылының қалдығы болады.", ["АТФ-те азотты негіз – аденин бар.", "Рибоза – бес көміртекті көмірсу.", "АТФ құрамында күкірт жоқ."]], ["Макроэргиялық байланыстар қай жерде шоғырланған?", ["Фосфор қышқылы қалдықтарының арасында", "Аденин мен рибоза арасында", "Рибоза ішінде", "Аденин сақинасында"], "Көп энергия алып жүретін байланыстар фосфат топтары арасында түзіледі.", ["Аденин мен рибоза арасындағы байланыс макроэргиялық емес.", "Рибоза ішіндегі байланыстар кәдімгі ковалентті байланыстар.", "Аденин сақинасында макроэргиялық байланыс жоқ."]], ["«Макроэргиялық байланыс» терминін енгізіп, оны (~) белгісімен белгілеуді ұсынған ғалым:", ["Ф. Липман", "Г. Мендель", "Т. Шванн", "Л. Пастер"], "Терминді Ф. Липман енгізген.", ["Мендель – тұқым қуалау заңдарының авторы.", "Шванн – жасуша теориясының негізін салушылардың бірі.", "Пастер ашу және микробиология зерттеулерімен белгілі."]], ["АТФ гидролизінің теңдеуі:", ["АТФ + Н₂О → АДФ + Н₃РО₄", "АДФ + Н₃РО₄ → АТФ + Н₂О", "АТФ → АМФ + Н₂О", "АТФ + О₂ → СО₂ + Н₂О"], "Ферменттер әсерінен АТФ су қосып, АДФ мен фосфор қышқылына ыдырайды.", ["Бұл – кері процесс, АТФ синтезі.", "Гидролиз су қосып жүреді, су бөлінбейді.", "АТФ оттекпен тотықпайды, ол гидролизденеді."]], ["АТФ-тен екінші фосфат қалдығы бөлінгенде не түзіледі?", ["АМФ", "АДФ", "Аденин", "Рибоза"], "Үшінші қалдық бөлінсе – АДФ, екіншісі бөлінсе – АМФ.", ["АДФ соңғы (үшінші) қалдық бөлінгенде түзіледі.", "Аденин – азотты негіз, фосфаттар бөлінгенде босамайды.", "Рибоза нуклеотидтің құрамында қалады."]], ["АТФ-ке жинақталмаған энергия қайда кетеді?", ["Жылу түрінде шашырайды", "Гликогенге айналады", "ДНҚ-ға жиналады", "Жасушадан фосфат ретінде шығады"], "Оқулық бойынша АТФ-ке жиналмаған энергия жылу түрінде шашырайды.", ["Гликоген – қор зат, энергия оған тікелей «құйылмайды».", "ДНҚ энергия жинамайды.", "Энергия фосфат ретінде шығарылмайды."]], ["Неліктен АТФ «энергия аккумуляторы» деп аталады?", ["АДФ пен фосфаттан түзілгенде энергияны сіңіріп жинақтайды", "Жасушада көп мөлшерде қорға жиналады", "Реакцияларға әрдайым тікелей түседі", "Тек бұлшықетте болады"], "АТФ түзілгенде энергия сіңіріліп, гидролизде босайды – аккумулятор сияқты.", ["АТФ қоры аз, сондықтан ол үздіксіз синтезделеді.", "АТФ реакцияға тікелей сирек түседі.", "АТФ барлық жасушада болады."]], ["АТФ-тің ең көп мөлшері қай жерде болады?", ["Қаңқа бұлшықеттерінде", "Бауырда", "Сүйек ұлпасында", "Май ұлпасында"], "Қаңқа бұлшықеттерінде АТФ 0,2–0,5% құрайды.", ["Бауырда гликоген жиналады.", "Сүйек ұлпасы ең көп АТФ-ке ие деп аталмайды.", "Май ұлпасы – энергия қорының жиналатын жері, АТФ емес."]], ["Организмдегі ұзақ мерзімді энергия аккумуляторы:", ["Май және гликоген", "АМФ", "Су", "Хлор иондары"], "Қорға жиналған май мен гликоген энергия аккумуляторы, ал АТФ оны тез жұмсауға қатысады.", ["АМФ – энергиясы аз, қор зат емес.", "Су энергия жинамайды.", "Хлор иондары энергия қоры емес."]], ["АТФ гидролизі кезінде энергия не үшін жұмсалмайды?", ["ДНҚ-ның азотты негіздерін өзгерту үшін", "Жүректің үздіксіз соғуы үшін", "Биоэлектрлік импульстер туғызу үшін", "Заттарды сіңіру және бөліп шығару үшін"], "Оқулықта АТФ энергиясының жұмсалатын бағыттарында азотты негіздерді өзгерту аталмайды.", ["Жүректің соғуын АТФ энергиясы қамтамасыз етеді.", "Жүйке жасушаларында импульстер АТФ энергиясымен туындайды.", "Заттарды сіңіру мен шығару да АТФ энергиясын қажет етеді."]]], "m": [["АТФ құрамына кіретін компоненттерді таңдаңыз.", ["Аденин", "Дезоксирибоза", "Рибоза", "Тимин", "Фосфор қышқылының қалдықтары", "Глицерин"], [0, 2, 4], ["Дұрыс: АТФ-тің азотты негізі – аденин.", "Дезоксирибоза – ДНҚ көмірсуы.", "Дұрыс: АТФ көмірсуы – рибоза.", "Тимин – ДНҚ-ға тән негіз.", "Дұрыс: үш фосфат қалдығы болады.", "Глицерин – майлардың құрамдас бөлігі."]], ["АТФ энергиясы жұмсалатын процестер:", ["Жасуша қозғалысы", "Оттектің қарапайым диффузиясы", "Судың осмоспен өтуі", "Жеңілдетілген диффузия", "Глюкозаның пассивті унипорты", "CO₂-нің мембранадан диффузиясы"], [0], ["Дұрыс: қозғалыс АТФ энергиясын қажет етеді.", "Қарапайым диффузия энергия жұмсамайды.", "Осмос – пассивті процесс, АТФ жұмсамайды.", "Жеңілдетілген диффузия – пассивті.", "Пассивті унипорт энергия жұмсамайды.", "CO₂ диффузиясы пассивті."]], ["АТФ гидролизінің өнімдері (бір фосфат бөлінгенде):", ["АДФ", "АМФ", "Н₃РО₄", "Глюкоза", "Аденин", "СО₂"], [0, 2], ["Дұрыс: соңғы фосфат бөлінгенде АДФ түзіледі.", "АМФ екінші фосфат бөлінгенде түзіледі.", "Дұрыс: фосфор қышқылы бөлінеді.", "Глюкоза гидролиз өнімі емес.", "Аденин нуклеотидтен бөлінбейді.", "СО₂ тотығу өнімі, гидролиз өнімі емес."]], ["Энергия қорына қатысты дұрыс тұжырымдар:", ["Гликоген бауырда жиналады", "АТФ жасушада көп мөлшерде қорға жиналады", "Май – энергия аккумуляторы", "Бұлшықеттегі АТФ қоры мыңдаған жиырылуға жетеді", "АТФ бір рет қана түзіледі", "Гликоген энергия қоры емес"], [0, 2], ["Дұрыс: гликоген бауырда жиналады.", "АТФ қоры көп емес.", "Дұрыс: қорға жиналған май энергия аккумуляторы.", "Қоры тек 20–30 жиырылуға жетеді.", "АТФ сансыз рет түзіліп, ыдырайды.", "Гликоген – энергия аккумуляторы."]], ["Макроэргиялық байланыстарға қатысты дұрыс тұжырымдар:", ["Фосфат топтары арасында түзіледі", "Аденин мен рибоза арасында болады", "Рибоза ішінде орналасады", "Үзілгенде энергия сіңіріледі", "Тек ДНҚ-да кездеседі", "Сутектік байланыстың бір түрі"], [0], ["Дұрыс: фосфор қалдықтары арасында жинақталған.", "Аденин мен рибоза арасындағы байланыс кәдімгі байланыс.", "Олар рибоза ішінде емес, фосфат топтары арасында.", "Үзілгенде энергия бөлінеді.", "Олар АТФ молекуласында болады.", "Олар сутектік емес, фосфат топтары арасындағы байланыс."]]], "x": [["Сәйкестендіріңіз: қосылыс – сипаттамасы", ["АТФ", "АДФ", "АМФ"], ["Бір фосфат қалдығы бар", "Үш фосфат қалдығы бар", "Екі фосфат қалдығы бар", "Фосфаты жоқ азотты негіз", "Төрт фосфат қалдығы бар"], [1, 2, 0], ["АТФ – аденозинүшфосфат, үш фосфат.", "АДФ – аденозиндифосфат, екі фосфат.", "АМФ – аденозинмонофосфат, бір фосфат."], "Фосфаты жоқ азотты негіз – аденин, ал төрт фосфатты қосылыс тақырыпта қарастырылмайды."], ["Сәйкестендіріңіз: АТФ бөлігі – атауы", ["Азотты негіз", "Көмірсу", "Энергиялы байланыс"], ["Макроэргиялық байланыс", "Аденин", "Рибоза", "Дезоксирибоза", "Урацил"], [1, 2, 0], ["АТФ-тің азотты негізі – аденин.", "АТФ-тің көмірсуы – рибоза.", "Фосфаттар арасындағы энергиялы байланыс – макроэргиялық."], "Дезоксирибоза – ДНҚ көмірсуы, урацил – АТФ құрамына кірмейтін РНҚ негізі."], ["Сәйкестендіріңіз: процесс – нәтижесі", ["АТФ