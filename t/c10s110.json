{"k": "<article class=\"topic\" id=\"k10_110_1\"><h2><span class=\"n\">1</span>Құрылысы және медиатор</h2>\n<div class=\"two\"><div><ul class=\"tree\">\n<li><b>Синапс</b> — екі нейронның немесе нейрон мен эффектор жасушаның түйіскен жері<ul><li>синапс алды мембрана</li><li>синапстық қуыс</li><li>синапстан кейінгі мембрана</li></ul></li>\n<li><b>Медиатор</b> — ацетилхолин (парасимпатикалық жүйке жүйесі)</li>\n<li><b>Көпіршік</b> — бірнеше мыңға дейін ацетилхолин молекуласы</li>\n</ul></div><figure><img src=\"data:image/webp;base64,\" alt=\"Холинергиялық синапс сұлбасы\" loading=\"lazy\"><figcaption>Холинергиялық синапс</figcaption></figure></div>\n<div class=\"flow\"><div><b>Холин + ацетил-КоА</b><span>ацетил-КоА – митохондриялық зат</span></div><i>→</i><div><b>Холинацетилаза</b><span>цитоплазмалық фермент</span></div><i>→</i><div><b>Ацетилхолин</b><span>көпіршіктерде сақталады</span></div><i>→</i><div><b>Импульс</b><span>синапстық қуысқа босайды</span></div></div>\n</article>\n<article class=\"topic\" id=\"k10_110_2\"><h2><span class=\"n\">2</span>Холинорецепторлар</h2>\n<div class=\"tbl\"><table><thead><tr><th>Түрі</th><th>Сезімталдығы / орны</th></tr></thead><tbody>\n<tr><td><b>М</b></td><td>мускарин (шыбынжұт алкалоиды)</td></tr>\n<tr><td><b>Н</b></td><td>никотин (темекі алкалоиды)</td></tr>\n<tr><td>М₁</td><td>вегетативті ганглиялар, ОЖЖ</td></tr>\n<tr><td>М₂</td><td>жүрек; ацетилхолин босауын төмендетеді</td></tr>\n<tr><td>М₃</td><td>бірыңғай салалы бұлшықет, эндокриндік бездер</td></tr>\n<tr><td>М₄</td><td>жүрек, өкпе альвеолалары, ОЖЖ</td></tr>\n<tr><td>М₅</td><td>ОЖЖ, көздің мөлдір қабығы, сілекей бездері</td></tr>\n</tbody></table></div>\n<ul class=\"tree\">\n<li><b>Н-рецепторлар</b> — ганглия нейрондары, бүйрекүсті безінің милы қабаты, Реншоу жасушалары, қаңқа бұлшықеттері<ul><li>ганглиялық (бейтарап) және бұлшықет типі</li><li>кураре жүйке-бұлшықет өткізгіштігін бұғаттайды</li></ul></li>\n</ul>\n</article>\n<article class=\"topic\" id=\"k10_110_3\"><h2><span class=\"n\">3</span>Қозудың берілуі</h2>\n<div class=\"flow\"><div><b>АХ + Н-рецептор</b><span>2 молекула жұп α-суббірлікке</span></div><i>→</i><div><b>Өзек ашылады</b><span>5 суббірлікті иондық өзек</span></div><i>→</i><div><b>Na⁺ кіреді</b><span>деполяризация</span></div><i>→</i><div><b>Синапстық потенциал</b><span>жергілікті</span></div><i>→</i><div><b>Әрекет потенциалы</b><span>шекке жеткенде</span></div></div>\n<ul class=\"tree\">\n<li><b>М-рецепторлар</b> — екінші реттік мессенджерлер мен G-нәруыздар арқылы</li>\n</ul>\n<div class=\"note\"><b>Есте сақта:</b> М – мускарин, Н – никотин; негізгі фармакологиялық әсерлер М₂ және М₃ арқылы.</div>\n</article>\n", "cards": [["Құр", "Холинергиялық синапс", "Екі нейронның немесе нейрон мен эффекторлық жасушаның түйіскен жері; медиаторы – ацетилхолин."], ["Құр", "Синапс неден тұрады?", "Синапс алды мембранадан, синапстық қуыстан және синапстан кейінгі мембранадан."], ["Құр", "Синапстың негізгі қызметі", "Медиатор мен рецепторлардың синапстан кейінгі мембранаға әсері арқылы жүйке импульсін беру."], ["Мед", "Парасимпатикалық жүйке жүйесінің медиаторы", "Ацетилхолин."], ["Мед", "Ацетилхолин неден түзіледі?", "Холин мен ацетилкоэнзим-А-дан (шығу тегі митохондриялық)."], ["Мед", "Ацетилхолин синтезінің ферменті", "Цитоплазмалық фермент – холинацетилаза."], ["Мед", "Ацетилхолин қайда синтезделеді?", "Нейронның холинергиялық ұштарындағы цитоплазмада."], ["Мед", "Ацетилхолин қайда сақталады?", "Синапстық көпіршіктерде; әр көпіршікте бірнеше мыңға дейін молекула болады."], ["Рец", "Холинорецепторлардың екі типі", "Н (никотинге сезімтал) және М (мускаринге сезімтал)."], ["Рец", "Мускарин", "Алкалоид; улы саңырауқұлақтарға, мысалы шыбынжұтқа тән."], ["Рец", "Никотин", "Темекі жапырағының құрамындағы алкалоид."], ["Рец", "М₁-холинорецепторлар", "Вегетативті ганглиялар мен ОЖЖ-да; синапстан тыс орналасады."], ["Рец", "М₂-холинорецепторлар", "Жүректе; кейбіреуі ацетилхолиннің босап шығуын төмендетеді."], ["Рец", "М₃-холинорецепторлар", "Бірыңғай салалы бұлшықеттерде және көбі эндокриндік бездерде."], ["Рец", "М₄ және М₅", "М₄ – жүрек, өкпе альвеолалары, ОЖЖ; М₅ – ОЖЖ, көздің мөлдір қабығы, сілекей бездері, мононуклеарлы қан жасушалары."], ["Рец", "Н-холинорецепторлар орны", "Ганглия нейрондары, синокаротидтік аймақ, бүйрекүсті безінің милы қабаты, нейрогипофиз, Реншоу жасушалары, қаңқа бұлшықеттері."], ["Рец", "Кураре", "Бұлшықетті сал ететін өсімдік заты; жүйке-бұлшықет өткізгіштігін бұғаттайды."], ["Бер", "Жүйке-бұлшықет синапсындағы холинорецептор", "Иондық өзекті қоршайтын бес нәруыз суббірлігінен тұрады, мембрананы тесіп өтеді."], ["Бер", "Иондық өзек қалай ашылады?", "Жұп ацетилхолин молекуласы жұп α-суббірлікпен байланысқанда."], ["Бер", "Na⁺ рөлі", "Ацетилхолин әсерінен Na⁺ жасушаға еніп, синапстан кейінгі мембрана деполяризацияланады."], ["Бер", "Жергілікті синапстық потенциал", "Деполяризациядан туатын потенциал; белгілі мөлшерге жеткенде әрекет потенциалы басталады."], ["Бер", "М-рецепторлар арқылы дабыл", "Екінші реттік мессенджерлер мен G-нәруыздар маңызды рөл атқарады."]], "tf": [["Холинергиялық синапстың медиаторы – ацетилхолин.", 1], ["Ацетилхолин синапстық қуыста синтезделеді.", 0], ["Ацетилхолин холин мен ацетил-КоА-дан холинацетилаза әсерінен түзіледі.", 1], ["Мускарин – темекі жапырағының алкалоиды.", 0], ["Н-холинорецепторлар никотинге сезімтал.", 1], ["М₂-холинорецепторлар жүректе орналасқан.", 1], ["Иондық өзек ашылу үшін бір ацетилхолин молекуласы жеткілікті.", 0], ["Ацетилхолин әсерінен Na⁺ иондары жасушаға енеді.", 1], ["Кураре жүйке-бұлшықет өткізгіштігін күшейтеді.", 0], ["Қаңқа бұлшықеттерінде Н-холинорецепторлар орналасады.", 1], ["Барлық Н-холинорецепторлардың заттарға сезімталдығы бірдей.", 0]], "qx": {"s": [["Холинергиялық синапстың медиаторы:", ["Ацетилхолин", "Норадреналин", "Серотонин", "Дофамин"], "Холинергиялық синапстарда таратқыш зат – ацетилхолин.", ["Норадреналин – адренергиялық синапстың медиаторы.", "Серотонин бұл синапстың медиаторы емес.", "Дофамин бұл синапстың медиаторы емес."]], ["Ацетилхолинді синтездейтін фермент:", ["Холинацетилаза", "Ацетилхолинэстераза", "АТФ-аза", "Амилаза"], "Синтез цитоплазмалық энзим – холинацетилаза әсерінен жүреді.", ["Ацетилхолинэстераза медиаторды ыдыратады, синтездемейді.", "АТФ-аза АТФ-ты ыдыратады.", "Амилаза – көмірсу ыдырататын фермент."]], ["Ацетилхолин синтезі үшін қажет митохондриялық зат:", ["Ацетилкоэнзим-А", "Глюкоза", "Пируват", "Лактат"], "Ацетилхолин холин мен ацетил-КоА-дан түзіледі.", ["Глюкоза тікелей қатыспайды.", "Пируват синтезге тікелей қатыспайды.", "Лактат – сүт қышқылы, қатыспайды."]], ["Ацетилхолин қайда сақталады?", ["Синапстық көпіршіктерде", "Синапстан кейінгі мембранада", "Ядрода", "Миелин қабығында"], "Синапстық көпіршіктерде бірнеше мыңға дейін молекула сақталады.", ["Мұнда рецепторлар орналасқан.", "Ядрода медиатор сақталмайды.", "Миелин – оқшаулағыш қабық."]], ["Мускаринге сезімтал рецепторлар:", ["М-холинорецепторлар", "Н-холинорецепторлар", "Адренорецепторлар", "Фоторецепторлар"], "Мускаринге сезімтал рецепторлар М деп белгіленеді.", ["Н – никотинге сезімтал.", "Адренорецепторлар норадреналинге жауап береді.", "Фоторецепторлар жарықты қабылдайды."]], ["Мускарин қай ағзаға тән алкалоид?", ["Шыбынжұт саңырауқұлағы", "Темекі", "Көкнәр", "Кофе ағашы"], "Мускарин улы саңырауқұлақтарға, мысалы шыбынжұтқа тән.", ["Темекіде никотин болады.", "Көкнәр мускарин көзі емес.", "Кофеде кофеин болады."]], ["Жүректе орналасып, ацетилхолин босауын төмендете алатын рецептор:", ["М₂", "М₁", "М₃", "М₅"], "М₂-холинорецепторлар жүректе орналасқан.", ["М₁ – вегетативті ганглиялар мен ОЖЖ-да.", "М₃ – бірыңғай салалы бұлшықет пен бездерде.", "М₅ – ОЖЖ, сілекей бездері т.б."]], ["Бірыңғай салалы бұлшықеттер мен эндокриндік бездерде көп орналасатын рецептор:", ["М₃", "М₂", "М₁", "М₄"], "М₃ бірыңғай салалы бұлшықеттер мен эндокриндік бездерде.", ["М₂ – жүректе.", "М₁ – ганглиялар мен ОЖЖ-да.", "М₄ – жүрек, альвеолалар, ОЖЖ."]], ["Жүйке-бұлшықет синапсындағы холинорецептор неше нәруыз суббірлігінен тұрады?", ["Бес", "Екі", "Үш", "Төрт"], "Холинорецептор иондық өзекті қоршайтын бес суббірліктен тұрады.", ["Екі – α-суббірліктер саны ғана.", "Үш емес.", "Төрт емес."]], ["Ацетилхолин молекулалары рецептордың қай суббірлігімен әрекеттеседі?", ["Жұп α-суббірлікпен", "β-суббірлікпен", "γ-суббірлікпен", "Барлық бес суббірлікпен бірдей"], "Жұп ацетилхолин молекуласы жұп α-суббірлікпен әрекетке түседі.", ["β-суббірлік аталмайды.", "γ-суббірлік аталмайды.", "Тек α-суббірліктер байланысады."]], ["Ацетилхолин Н-рецепторға әсер еткенде жасушаға енетін ион:", ["Na⁺", "Cl⁻", "Ca²⁺ шығады", "K⁺ кіреді"], "Na⁺ иондары енуі деполяризация тудырады.", ["Cl⁻ кірсе гиперполяризация болар еді.", "Мәтінде Ca²⁺ туралы айтылмайды.", "K⁺ кірмейді."]], ["Жүйке-бұлшықет өткізгіштігін бұғаттайтын зат:", ["Кураре", "Ацетилхолин", "Холин", "Ацетил-КоА"], "Кураре тәрізді заттар бұлшықетті сал етеді.", ["Ацетилхолин – медиатор, өткізгіштікті қамтамасыз етеді.", "Холин – синтез бастамасы.", "Ацетил-КоА – синтез бастамасы."]], ["М-холинорецепторлар арқылы дабыл беруде маңызды рөл атқарады:", ["G-нәруыздар мен екінші реттік мессенджерлер", "Тек Na⁺ өзектері", "Миелин", "Тропонин"], "М-рецепторлар ынталандырылғанда екінші реттік мессенджерлер мен G-нәруыздар қатысады.", ["Иондық өзек – Н-рецепторға тән.", "Миелин дабыл беруге қатыспайды.", "Тропонин – бұлшықет нәруызы."]]], "m": [["Н-холинорецепторлар орналасатын жерлер:", ["Қаңқа бұлшықеттері", "Бүйрекүсті безінің милы қабаты", "Реншоу жасушалары", "Сілекей бездері", "Көздің мөлдір қабығы", "Эндокриндік бездер"], [0, 1, 2], ["Дұрыс: бұлшықет типті Н-рецепторлар.", "Дұрыс.", "Дұрыс.", "М₅-рецепторлар орны.", "М₅-рецепторлар орны.", "М₃-рецепторлар орны."]], ["Холинергиялық синапстың құрамдас бөліктері:", ["Синапс алды мембрана", "Синапстық қуыс", "Синапстан кейінгі мембрана", "Миелин қабығы", "Ранвье үзілімі", "Саркомер"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Синапс құрамына кірмейді.", "Аксон бөлігі.", "Бұлшықет бірлігі."]], ["Ацетилхолин синтезіне қатысады:", ["Холин", "Ацетилкоэнзим-А", "Холинацетилаза", "Мускарин", "Никотин", "Кураре"], [0, 1, 2], ["Дұрыс: бастапқы зат.", "Дұрыс: митохондриялық зат.", "Дұрыс: фермент.", "Алкалоид, рецепторға әсер етеді.", "Алкалоид, рецепторға әсер етеді.", "Бұғаттағыш зат."]], ["Жүректе орналасатын М-холинорецепторлар:", ["М₂", "М₄", "М₁", "М₃", "М₅", "Н-ганглиялық"], [0, 1], ["Дұрыс.", "Дұрыс: жүрек, альвеолалар, ОЖЖ.", "Ганглиялар мен ОЖЖ.", "Бірыңғай салалы бұлшықет.", "ОЖЖ, сілекей бездері.", "Ганглияларда."]]], "x": [["Сәйкестендіріңіз: рецептор – орны", ["М₁", "М₃", "М₅"], ["Вегетативті ганглиялар, ОЖЖ", "Бірыңғай салалы бұлшықет, эндокриндік бездер", "ОЖЖ, сілекей бездері, мөлдір қабық", "Тек бауыр", "Тек сүйек кемігі"], [0, 1, 2], ["М₁ синапстан тыс орналасады.", "М₃ – бездер мен салалы бұлшықет.", "М₅ – мононуклеарлы қан жасушаларында да."], "Бауыр мен сүйек кемігі мәтінде аталмайды."], ["Сәйкестендіріңіз: зат – сипаты", ["Мускарин", "Никотин", "Кураре"], ["Шыбынжұттың алкалоиды", "Темекінің алкалоиды", "Жүйке-бұлшықет өткізгіштігін бұғаттайды", "Ацетилхолинді синтездейді", "Медиатор"], [0, 1, 2], ["М-рецепторлар осы затқа сезімтал.", "Н-рецепторлар осы затқа сезімтал.", "Бұлшықетті сал етеді."], "Синтездейтін – холинацетилаза, медиатор – ацетилхолин."]]}, "toc": [["k10_110_1", "Құрылысы және медиатор"], ["k10_110_2", "Холинорецепторлар"], ["k10_110_3", "Қозудың берілуі"]], "cats": {"Құр": "Құрылысы", "Мед": "Ацетилхолин", "Рец": "Холинорецепторлар", "Бер": "Қозудың берілуі"}}