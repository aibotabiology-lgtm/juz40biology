опия", "Сколиоз"], [0, 1, 2, 3], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Дұрыс.", "Жұқпалы емес.", "Жұқпалы емес."]], ["ПТР-диагностиканың артықшылықтары:", ["Жоғары сезімталдық", "Жоғары спецификалылық", "Нәтиже жылдамдығы", "Жасырын инфекцияны табу", "Нәтиже бірнеше айдан кейін", "Тек көп мөлшерде микроб қажет"], [0, 1, 2, 3], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Дұрыс.", "Керісінше, тез.", "Аз мөлшер жеткілікті."]], ["ДНҚ-типирлеудің маңызы:", ["Қылмыскерді анықтау", "Жазықсызды ақтау", "Генетикалық деректер қорын құру", "Қан тобын өзгерту", "Мутацияны емдеу", "Жынысты өзгерту"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Мүмкін емес.", "Емдеу әдісі емес.", "Қатысы жоқ."]]], "x": [["Сәйкестендіріңіз: сала – ПТР-дің қолданылуы", ["Криминалистика", "Медициналық диагностика", "Дербес медицина"], ["Генетикалық саусақ ізін салыстыру", "Қоздырғыштың ДНҚ-сын анықтау", "Дәрі алдында генотиптеу", "Нан ашыту", "Сүт өнімдерін алу"], [0, 1, 2], ["ДНҚ-типирлеу.", "Патогенге тән праймерлер.", "Цитохром түрін анықтау."], "Нан ашыту мен сүт өнімдері — микробиология, ПТР емес."], ["Сәйкестендіріңіз: ұғым – анықтама", ["Генетикалық саусақ ізі", "ДНҚ-типирлеу", "Алдын ала генотиптеу"], ["ДНҚ жолақтарының суреті", "Генетикалық айырмашылықпен сәйкестендіру", "Дәрі алдындағы ПТР-талдау", "Хромосома санын анықтау", "Ақуыз ретін анықтау"], [0, 1, 2], ["Электрофорез нәтижесі.", "Геномдық дактилоскопия.", "Дербес медицина талдауы."], "Хромосома санын кариотип көрсетеді."]]}, "toc": [["k10_123_1", "Криминалистика және әкелікті анықтау"], ["k10_123_2", "ПТР-диагностика"], ["k10_123_3", "Дербес медицина және артықшылықтар"]], "cats": {"Крим": "Криминалистика", "Әке": "Әкелікті анықтау", "Диагн": "ПТР-диагностика", "Дербес": "Дербес медицина"}}