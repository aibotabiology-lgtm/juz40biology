джи жиынтығы", "Пероксисома"], [0, 2], ["Дұрыс: митохондрияларда прокариоттық типті рибосомалар бар.", "Ядрошықта эукариот рибосомасының суббірліктері жиналады.", "Дұрыс: пластидтерде де прокариоттық типті рибосомалар бар.", "Центросома микротүтікшелер орталығы, рибосомасы жоқ.", "Оқулықта Гольджи жиынтығында рибосомалар аталмайды.", "Оқулықта пероксисомадағы рибосомалар аталмайды."]]], "x": [["Сәйкестендіріңіз: нәруыз – рөлі", ["Тубулин", "Актин", "Кинезин"], ["Жүкті (+) ұшына тасымалдайтын моторлы нәруыз", "Микрофиламенттердің құрамы", "Микротүтікшелердің құрамы", "Жүкті (−) ұшына тасымалдайтын моторлы нәруыз", "Мембранадағы «затбелгі»"], [2, 1, 0], ["Тубулиннен микротүтікшелер түзіледі.", "Актиннен микрофиламенттер құралады.", "Кинезин жүкті (+) ұшына, ортадан шетке тасиды."], "(−) ұшына динеин тасиды, «затбелгі» – мембранадағы гликопротеин."], ["Сәйкестендіріңіз: құрылым – сипаттамасы", ["Аналық центриоль", "Қосалқы центриоль", "Диплосома"], ["Рибосомалар тобы", "Қуысында тығыз нәруызды түзіліс бар", "Тікбұрыш жасаған екі центриоль", "Ұшында тоғыз бүйірлік «қолы» бар", "Тубулиннің жұп глобуласы"], [3, 1, 2], ["Аналық (жетілген) центриоль тоғыз «қолынан» танылады.", "Қосалқы центриоль қуысында тығыз нәруызды түзіліс болады.", "Интерфазадағы тікбұрышты екі центриоль – диплосома."], "Рибосомалар тобы – полисома, тубулиннің жұп глобуласы – димер."]]}, "toc": [["k10_21_1", "Цитоплазма"], ["k10_21_2", "Цитоқаңқа"], ["k10_21_3", "Жасуша орталығы"], ["k10_21_4", "Рибосомалар"]], "cats": {"Цито": "Цитоплазма, гиалоплазма", "Қаңқа": "Цитоқаңқа", "Центр": "Жасуша орталығы", "Рибо": "Рибосомалар"}}