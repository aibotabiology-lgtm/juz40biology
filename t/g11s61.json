ыртқыш балықтар", "Дельфиндер"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Продуценттер.", "Консументтер.", "Консументтер."]], ["Энергияның басым бөлігі жұмсалатын процестер:", ["Қозғалыс", "Тыныс алу", "Денені жылыту", "Нәруыз жинау", "Май жинау", "Фотосинтез"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "10%-ке кіреді.", "10%-ке кіреді.", "Энергияны жинайды."]], ["Атмосфераны ластайтын көздер:", ["Автокөліктің пайдаланылған газы", "Органикалық отынның жану өнімдері", "Өндіріс қалдықтары", "Ағаштардың жапырағы", "Озон қабаты", "Жасыл желек"], [0, 1, 2], ["Дұрыс.", "Дұрыс.", "Дұрыс.", "Ағаштар ауаны тазартады.", "Озон қорғайды.", "Ауаны тазартады."]]], "x": [["Сәйкестендіріңіз: шама – формула", ["Зат мөлшері (массадан)", "Молекула саны", "Газ көлемі (қ.ж.)"], ["n = m/M", "N = n·Nₐ", "V = n·Vₘ", "m = V/ρ", "p = 1 − q"], [0, 1, 2], ["Масса / молярлық масса.", "Мөлшер × Авогадро тұрақтысы.", "Мөлшер × 22,4 л/моль."], "p = 1 − q – Харди–Вайнберг заңынан."], ["Сәйкестендіріңіз: организм тобы – қоректену типі", ["Продуценттер", "Консументтер", "Редуценттер"], ["Фотосинтетиктер", "Эврифагтар", "Деструкторлар", "Вирустар", "Минералдар"], [0, 1, 2], ["Органика түзеді.", "Әр түрлі қорек жейді.", "Органиканы ыдыратады."], "Вирустар мен минералдар қоректену типі емес."]]}, "toc": [["k11_61_1", "Қоректену типтері"], ["k11_61_2", "Пирамида есептерінің негізі"], ["k11_61_3", "Экологиялық есеп түрлері"]], "cats": {"Деңгей": "Трофикалық деңгейлер", "Ереже": "Пирамида ережесі", "Жағдай": "Экологиялық жағдайлар", "Формула": "Есеп формулалары"}}