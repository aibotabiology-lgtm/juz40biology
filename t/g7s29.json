{"k": "<article class=\"topic\" id=\"k7_29_1\"><h2><span class=\"n\">1</span>Бөліп шығарудың маңызы</h2>\n<ul class=\"tree\">\n<li><b>Шлактар</b> — зат алмасудың ақырғы өнімдері<ul><li>жиналса — ағзаның өздігінен улануы</li><li>шығарылады: улы заттар, артық су, дәрумен, ауыр металдар</li></ul></li>\n<li><b>Жасуша</b> — қалдықты мембрана арқылы қанға шығарады</li>\n<li><b>Өсімдік</b> — арнайы мүше жоқ<ul><li>қалдық — жапырақ вакуолінде, хромопластында</li><li>CO₂ — жапырақ саңылауы арқылы</li></ul></li>\n</ul>\n</article>\n<article class=\"topic\" id=\"k7_29_2\"><h2><span class=\"n\">2</span>Адамның бөлу мүшелері</h2>\n<div class=\"two\"><div>\n<div class=\"tbl\"><table><thead><tr><th>Мүше</th><th>Не шығарады</th></tr></thead><tbody>\n<tr><td><b>Бүйрек</b></td><td>басты мүше: қанды тазартады, зәр</td></tr>\n<tr><td><b>Өкпе</b></td><td>CO₂, су буы, ұшқыш заттар</td></tr>\n<tr><td><b>Тері</b></td><td>су, тұздар, азотты заттар — тер</td></tr>\n<tr><td><b>Асқорыту бездері</b></td><td>ауыр металдар, емдік заттар</td></tr>\n<tr><td><b>Бауыр</b></td><td>залалсыздандырады; гормондар, гемоглобин ыдырау өнімдері</td></tr>\n</tbody></table></div>\n</div><figure><img src=\"data:image/webp;base64,\" alt=\"Адамның зәр шығару жүйесі\" loading=\"lazy\"><figcaption>Зәр шығару жүйесі</figcaption></figure></div>\n</article>\n<article class=\"topic\" id=\"k7_29_3\"><h2><span class=\"n\">3</span>Жануарлардың бөлу мүшелері</h2>\n<div class=\"tbl\"><table><thead><tr><th>Жануарлар</th><th>Мүше</th></tr></thead><tbody>\n<tr><td>Қарапайымдар</td><td><b>жиырылғыш вакуоль</b></td></tr>\n<tr><td>Құрттар</td><td>зәр шығару түтікшелері</td></tr>\n<tr><td>Шаянтәрізділер</td><td><b>жасыл бездер</b></td></tr>\n<tr><td>Өрмекшілер, жәндіктер</td><td><b>Мальпигий түтікшелері</b></td></tr>\n<tr><td>Омыртқалылар, ұлулар</td><td><b>бүйрек</b> — ең жетілген</td></tr>\n</tbody></table></div>\n</article>\n<article class=\"topic\" id=\"k7_29_4\"><h2><span class=\"n\">4</span>Соңғы өнімдер</h2>\n<div class=\"flow\"><div><b>Май, көмірсу</b><span>C, O, H</span></div><i>→</i><div><b>+ оттек</b><span>ыдырау</span></div><i>→</i><div><b>CO₂ + H₂O</b><span>соңғы өнім</span></div></div>\n<ul class=\"tree\">\n<li><b>Нәруыз</b> — құрамында азот бар<ul><li>азотты шлактар: аммиак, несепнәр, зәр қышқылы</li><li>адамда негізгісі — несепнәр</li></ul></li>\n<li><b>Шығу жолы</b> — бүйрек арқылы зәрмен, тері арқылы термен</li>\n</ul>\n<div class=\"note\"><b>Есте сақта:</b> басты бөлу мүшесі — бүйрек; негізгі азотты шлак — несепнәр.</div>\n</article>", "cards": [["Маңызы", "Шлактар дегеніміз не?", "Жасушада түзілетін тіршілік әрекетінің қалдықтары (зиянды заттар). Барлық шлак ағза үшін зиян."], ["Маңызы", "Ағзаның өздігінен улануы қашан жүреді?", "Шлактар жасушада, ұлпада немесе мүшелерде жиналып қалса."], ["Маңызы", "Жасуша зиянды заттарды қалай шығарады?", "Мембрана арқылы."], ["Маңызы", "Өсімдік жасушасында қалдықтар қайда жиналады?", "Күзгі жапырақтың хромопластында немесе вакуолінде."], ["Маңызы", "Организмнен қандай заттар шығарылуы тиіс?", "Зат алмасудың ақырғы (соңғы) өнімдері, улы заттар, артық су, артық дәрумендер, емдік заттар, ауыр металдар."], ["Маңызы", "Бұл заттар артық мөлшерде жиналса не болады?", "Денсаулық бұзылады – ағзаның өздігінен улануы жүреді."], ["Маңызы", "Көпжасушалы жануарда зиянды заттар жасушадан қайда шығарылады?", "Қанға."], ["Маңызы", "Жануар ағзасын шлактан тазартуға не жауапты?", "Тыныс алу және бөлу мүшелері."], ["Мүше", "Қанды зиянды заттардан тазартатын басты бөлу мүшесі", "Бүйрек."], ["Мүше", "Бөліп шығаруда қосымша қызмет атқаратын мүше", "Тері (тер шығарады)."], ["Мүше", "Бауырдың бөліп шығарудағы рөлі", "Зиянды заттарды залалсыздандырады: бүйрек арқылы шығарылар алдында оларды өзгертеді."], ["Мүше", "Өкпе арқылы не шығарылады?", "Көмірқышқыл газы, су буы, кейбір ұшқыш заттар (эфир буы, наркоз кезіндегі хлороформ)."], ["Мүше", "Өсімдіктерде арнайы бөлу мүшесі бар ма?", "Жоқ. Бұл қызметті жапырақтар мен қылқандар атқарады, кейін олар түсіп қалады."], ["Мүше", "Өсімдік көмірқышқыл газын қалай шығарады?", "Жапырақ саңылауы арқылы."], ["Мүше", "Зат алмасудың сұйық өнімдері қайда шығады?", "Бүйрек (зәрмен) және тері (термен) арқылы."], ["Өнім", "Майлар мен көмірсулар қандай элементтерден тұрады?", "Үш элементтен: көміртек, оттек, сутек."], ["Өнім", "Майлар мен көмірсулар ыдырағанда не түзіледі?", "Көмірқышқыл газы мен су."], ["Өнім", "Нәруызды май мен көмірсудан ажырататын элемент", "Азот – нәруыз құрамына міндетті түрде кіреді."], ["Өнім", "Азоты бар соңғы заттардың үш тобы", "Аммиак, несепнәр (мочевина), зәр қышқылы."], ["Өнім", "Адам мен сүтқоректілердің негізгі азотты шлагы", "Несепнәр (мочевина)."], ["Өнім", "Бауыр азотты шлакпен не істейді?", "Оның уыттылығын азайтып, бүйрек арқылы шығаруға қолжетімді етеді."], ["Өнім", "Жануарлар энергияны қалай алады?", "Тыныс алуда оттектің әсерінен нәруыз, май, көмірсулар ыдырағанда."], ["Мүше", "Сілекей және асқазан бездері нені бөліп шығарады?", "Ауыр металдарды, кейбір емдік заттарды, бөгде органикалық қоспаларды."], ["Мүше", "Ұйқы безі мен ішек бездері нені шығарады?", "Ауыр металл тұздарын, емдік заттарды."], ["Мүше", "Бауыр қаннан нені бөліп шығарады?", "Гормондарды (тироксин, фолликулин) және гемоглобиннің ыдырау өнімдерін (өтпен)."], ["Жануар", "Қарапайымдардың зәр шығару органоиды", "Жиырылғыш вакуоль."], ["Жануар", "Құрттар мен паразит құрттардың шығару мүшелері", "Құрттарда – зәр шығару түтікшелері, паразит құрттарда – сыртқа шығару каналдары."], ["Жануар", "Шаянтәрізділердің зәр шығару мүшесі", "Жасыл бездер."], ["Жануар", "Өрмекшілер мен жәндіктердің зәр шығару мүшесі", "Мальпигий түтікшелері."], ["Жануар", "Зәр шығарудың негізгі мүшесі бүйрек болатын жануарлар", "Адам, сүтқоректілер, құстар, жорғалаушылар, қосмекенділер, балықтар, ұлулар."]], "tf": [["Шлактар жасушада жиналса, ағзаның өздігінен улануы жүреді.", 1], ["Адам мен сүтқоректілердегі негізгі азотты шлак – аммиак.", 0], ["Қанды зиянды заттардан тазартатын басты мүше – бүйрек.", 1], ["Тері – бөліп шығарудың басты мүшесі, бүйрек – қосымша мүше.", 0], ["Өсімдіктерде арнайы бөлу мүшелері болмайды.", 1], ["Майлар мен көмірсулар ыдырағанда азотты заттар түзіледі.", 0], ["Нәруыз құрамына міндетті түрде азот кіреді.", 1], ["Бауыр зиянды заттарды залалсыздандыруда маңызды рөл атқарады.", 1], ["Өсімдік көмірқышқыл газын тамыр түктері арқылы шығарады.", 0], ["Өсімдік жасушасында қалдықтар хлоропластта жиналады.", 0], ["Артық тұз бүйрек арқылы зәрмен және тері арқылы термен шығарылады.", 1], ["Көпжасушалы жануарда зиянды заттар жасушадан тікелей сыртқа, қанды айналып өтіп шығарылады.", 0], ["Сілекей және асқазан бездері ауыр металдарды бөліп шығаруға қатысады.", 1], ["Шаянтәрізділердің зәр шығару мүшесі – мальпигий түтікшелері.", 0], ["Өкпе арқылы көмірқышқыл газымен бірге су буы да шығарылады.", 1], ["Ұлуларда бүйрек болмайды, олар жиырылғыш вакуоль арқылы бөліп шығарады.", 0]], "qx": {"s": [["Адамда қанды зиянды заттардан тазартатын басты бөлу мүшесі:", ["Бүйрек", "Тері", "Бауыр", "Өкпе"], "Оқулық бойынша қанның тазаруына жауапты басты бөлу мүшесі – бүйрек.", ["Тері қосымша қызмет атқарады.", "Бауыр заттарды залалсыздандырады, бірақ басты бөлу мүшесі емес.", "Өкпе газдар мен су буын шығарады, қанды тазартатын басты мүше емес."]], ["Бөліп шығаруда қосымша қызмет атқаратын мүше:", ["Тері", "Бүйрек", "Жүрек", "Көз"], "Тері тер арқылы су, тұз, азотты заттарды шығарып, қосымша қызмет атқарады.", ["Бүйрек – басты бөлу мүшесі.", "Жүрек бөліп шығару мүшесі емес.", "Көз – сезім мүшесі, бөліп шығармайды."]], ["Ағзадағы зиянды заттарды залалсыздандыратын мүше:", ["Бауыр", "Өкпе", "Тері", "Қуық"], "Бауыр зиянды заттарды бүйрек арқылы шығарар алдында өзгертіп, залалсыздандырады.", ["Өкпе газ алмасу өнімін шығарады.", "Тері тер шығарады, залалсыздандырмайды.", "Қуық зәрді жинайды ғана."]], ["Адам мен сүтқоректілердегі азоты бар негізгі шлак:", ["Несепнәр (мочевина)", "Аммиак", "Зәр қышқылы", "Көмірқышқыл газы"], "Оқулықта адам мен сүтқоректілер үшін негізгі азотты шлак – несепнәр деп көрсетілген.", ["Аммиак – азотты заттардың бір тобы, бірақ сүтқоректілерде негізгісі емес.", "Зәр қышқылы да азотты зат, бірақ негізгісі емес.", "Көмірқышқыл газында азот жоқ."]], ["Майлар мен көмірсулар оттекпен ыдырағанда түзілетін соңғы өнімдер:", ["Көмірқышқыл газы мен су", "Аммиак пен су", "Несепнәр мен көмірқышқыл газы", "Зәр қышқылы мен оттек"], "Олар C, O, H-тан тұрады, сондықтан ыдырағанда сол элементтерден тұратын CO₂ мен су түзіледі.", ["Аммиак құрамында азот бар, ал май мен көмірсуда азот жоқ.", "Несепнәр нәруыз ыдырағанда түзіледі.", "Зәр қышқылы – азотты зат; оттек соңғы өнім емес, ыдыратушы."]], ["Нәруыздар толық ыдырағанда азотты заттар түзілуінің себебі:", ["Нәруыз құрамына міндетті түрде азот кіреді", "Нәруыздар тек көміртектен тұрады", "Нәруыз бауырда азотқа айналады", "Азот ауадан жасушаға енеді"], "Азот нәруыздың міндетті құрамдас бөлігі болғандықтан, ыдырағанда азотты соңғы заттар түзіледі.", ["Нәруыз құрамында C, O, H және N бар.", "Бауыр азотты шлакты түзбейді, оның уыттылығын азайтады.", "Азотты шлактар нәруыздан шығады, ауадан емес."]], ["Майлар мен көмірсулар қандай элементтерден тұрады?", ["Көміртек, оттек, сутек", "Көміртек, азот, сутек", "Азот, оттек, сутек", "Көміртек, оттек, азот"], "Оқулық бойынша майлар мен көмірсулар үш элементтен – C, O, H-тан тұрады.", ["Азот май мен көмірсуға тән емес.", "Азот бұл топқа кірмейді, көміртек түсіп қалған.", "Азот емес, сутек болуы керек."]], ["Өсімдіктерде бөліп шығару қызметін атқаратын мүшелер:", ["Жапырақтар мен қылқандар", "Тамырлар", "Гүлдер", "Тұқымдар"], "Арнайы бөлу мүшесі жоқ өсімдіктерде бұл қызметті кейін түсіп қалатын жапырақтар мен қылқандар атқарады.", ["Тамыр су мен минералды заттарды сіңіреді.", "Гүл – көбею мүшесі.", "Тұқым – көбею мен таралу үшін."]], ["Өсімдік көмірқышқыл газын шығаратын құрылым:", ["Жапырақ саңылауы", "Тамыр түктері", "Сабақ өзегі", "Гүл тостағаншасы"], "CO₂ өсімдіктерде жапырақ саңылауы арқылы шығарылады.", ["Тамыр түктері су сіңіреді.", "Сабақ өзегі газ шығармайды.", "Гүл тостағаншасы газ алмасу қызметін атқармайды."]], ["Өсімдік жасушасында қалдықтар жиналатын орын:", ["Вакуоль немесе күзгі жапырақтың хромопласты", "Ядро", "Хлоропласт", "Жасуша қабықшасы"], "Оқулық бойынша қалдықтар күзгі жапырақ хромопластында не вакуолінде жиналады.", ["Ядро тұқымқуалау ақпаратын сақтайды.", "Хлоропласт – фотосинтез органоиды.", "Қабықша – жасушаның сыртқы қаңқасы."]], ["Шлактар мүшелерде жиналып қалғанда байқалатын құбылыс:", ["Ағзаның өздігінен улануы", "Фотосинтез күшеюі", "Ағзаның тез өсуі", "Зат алмасудың тоқтауы бірден"], "Барлық шлак зиянды, жиналса ағзаның өздігінен улануы жүреді.", ["Фотосинтез шлакқа байланысты емес.", "Шлак өсуді жылдамдатпайды, зиян келтіреді.", "Оқулықта зат алмасу бірден тоқтайды деп айтылмайды, улану жүреді."]], ["Зат алмасудың сұйық өнімдері жануарларда шығарылатын мүшелер:", ["Бүйрек және тері", "Өкпе және ми", "Жүрек және өкпе", "Жүрек және көз"], "А оқулығы бойынша сұйық өнімдер бүйрек (зәр) және тері (тер) арқылы шығады.", ["Өкпе газ бен су буын шығарады, ми бөліп шығармайды.", "Жүрек бөліп шығару мүшесі емес, өкпе сұйық өнімді емес, газды шығарады.", "Жүрек – қанайналым, көз – сезім мүшесі."]], ["Көпжасушалы жануарлардың жасушасынан зиянды заттар алдымен қайда түседі?", ["Қанға", "Тікелей сыртқа", "Өкпеге", "Асқазанға"], "Жоғары құрылымды көпжасушалыларда зиянды заттар жасушадан қанға шығарылады, кейін бөлу мүшелері тазартады.", ["Көпжасушалыда әр жасуша тікелей сыртқа шығара алмайды.", "Өкпеге тек CO₂ қан арқылы жетеді.", "Асқазан шлак жинамайды."]], ["Бауырдың азотты шлакқа әсері:", ["Уыттылығын азайтып, бүйрек арқылы шығаруға қолжетімді етеді", "Оны көмірқышқыл газына айналдырады", "Оны өкпе арқылы шығарады", "Оны майға айналдырып жинайды"], "Бауыр химиялық реакциялар арқылы азотты шлактың улылығын азайтады.", ["Азотты зат CO₂-ге айналмайды.", "Өкпе тек газ шығарады.", "Бауыр шлакты қорға жинамайды."]], ["Азотты заттардың негізгі үш тобына жатпайтыны:", ["Глюкоза", "Аммиак", "Несепнәр", "Зәр қышқылы"], "Глюкоза – көмірсу, оның құрамында азот жоқ.", ["Аммиак – азотты заттардың бір тобы.", "Несепнәр – азотты заттардың бір тобы.", "Зәр қышқылы – азотты заттардың бір тобы."]], ["Өрмекшілер мен жәндіктердің зәр шығару мүшесі:", ["Мальпигий түтікшелері", "Жасыл бездер", "Жиырылғыш вакуоль", "Бүйрек"], "Өрмекшілер мен жәндіктерде зәр шығаруды мальпигий түтікшелері атқарады.", ["Жасыл бездер – шаянтәрізділердің мүшесі.", "Жиырылғыш вакуоль – қарапайымдардың органоиды.", "Бүйрек – омыртқалылар мен ұлуларға тән."]], ["Шаянтәрізділердің зәр шығару мүшесі:", ["Жасыл бездер", "Мальпигий түтікшелері", "Жиырылғыш вакуоль", "Тер бездері"], "Шаянтәрізділерде зәр шығару қызметін жасыл бездер атқарады.", ["Мальпигий түтікшелері – өрмекшілер мен жәндіктерге тән.", "Жиырылғыш вакуоль – біржасушалыларда.", "Тер бездері – сүтқоректілердің терісінде."]], ["Наркоз кезінде енгізілген хлороформды организмнен шығаратын мүше:", ["Өкпе", "Бүйрек", "Бауыр", "Тер бездері"], "Өкпе CO₂, су буымен бірге эфир, хлороформ сияқты ұшқыш заттарды да шығарады.", ["Бүйрек ұшқыш заттарды емес, зәрді шығарады.", "Бауыр ұшқыш заттарды дем арқылы шығармайды.", "Тер бездері су мен тұздарды шығарады."]], ["Ауыр металдарды, емдік заттарды, бөгде органикалық қоспаларды бөліп шығаратын бездер:", ["Сілекей және асқазан бездері", "Тер бездері", "Қалқанша без", "Бүйрекүсті безі"], "Мектеп оқулығы бойынша бұл заттарды сілекей және асқазан бездері бөліп шығарады.", ["Тер бездері негізінен су мен тұздарды шығарады.", "Қалқанша без гормон түзеді, бөліп шығару безі емес.", "Бүйрекүсті безі гормон түзеді."]], ["Зәр шығарудың негізгі мүшесі бүйрек болатын топ:", ["Балықтар", "Жәндіктер", "Шаянтәрізділер", "Қарапайымдар"], "Балықтар, қосмекенділер, жорғалаушылар, құстар, сүтқоректілер және ұлулар бүйрек арқылы зәр шығарады.", ["Жәндіктерде – мальпигий түтікшелері.", "Шаянтәрізділерде – жасыл бездер.", "Қарапайымдарда – жиырылғыш вакуоль."]]], "m": [["Азоты бар соңғы (зиянды) заттарды таңдаңыз.", ["Аммиак", "Несепнәр